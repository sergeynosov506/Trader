            </a>
        </div>

        <!-- 2. BUSINESS & INDUSTRY -->
        <div class="nav-category-header text-uppercase small px-2 mt-3 mb-1">
            <span>🏭 @Loc["nav.category.business"]</span>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "Production" ? "active" : "")" href="#" @onclick:preventDefault @onclick='() => SetView("Production")'>
                <span class="nav-icon">🏭</span> <span>@Loc["nav.production"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "Logistics" ? "active" : "")" href="#" @onclick:preventDefault @onclick='() => SetView("Logistics")'>
                <span class="nav-icon">🚚</span> <span>@Loc["nav.logistics"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "Housing" ? "active" : "")" href="#" @onclick:preventDefault @onclick='() => SetView("Housing")'>
                <span class="nav-icon">🏠</span> <span>@Loc["nav.housing"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "Inventory" ? "active" : "")" href="#" @onclick:preventDefault @onclick='() => SetView("Inventory")'>
                <span class="nav-icon">🎒</span> <span>@Loc["nav.inventory"]</span>
            </a>
        </div>

        <!-- 3. FINANCE -->
        <div class="nav-category-header text-uppercase small px-2 mt-3 mb-1">
            <span>🏦 @Loc["nav.category.finance"]</span>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "Bank" ? "active" : "")" href="#" @onclick:preventDefault @onclick='() => SetView("Bank")'>
                <span class="nav-icon">🏦</span> <span>@Loc["nav.bank"]</span>
            </a>
        </div>

        <!-- 4. ENTERTAINMENT -->
        <div class="nav-category-header text-uppercase small px-2 mt-3 mb-1">
