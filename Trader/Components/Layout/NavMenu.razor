@inject EconomicGame.Services.NavigationStateService NavState
@inject LocalizationService Loc
@implements IDisposable

<!-- ================= DESKTOP SIDEBAR ================= -->
<div class="desktop-sidebar d-none d-md-flex flex-column">
    <div class="sidebar-brand d-flex align-items-center justify-content-between px-3 py-3">
        <a class="brand-link d-flex align-items-center gap-2 text-decoration-none text-white" href="#" @onclick:preventDefault @onclick='() => SetView("Market")'>
            <span class="fs-4">🏙️</span>
            <div>
                <div class="brand-title fw-bold">@Loc["app.title"]</div>
                <div class="brand-sub small text-white-50">Economy & AI Sim</div>
            </div>
        </a>
    </div>

    <div class="sidebar-nav flex-grow-1 overflow-y-auto px-2 py-2">
        <!-- 1. TRADE & MARKET -->
        <div class="nav-category-header text-uppercase small px-2 mt-2 mb-1">
            <span>📈 @Loc["nav.category.trade"]</span>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "Market" ? "active" : "")" href="#" @onclick:preventDefault @onclick='() => SetView("Market")'>
                <span class="nav-icon">📊</span> <span>@Loc["nav.market"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "StockExchange" ? "active" : "")" href="#" @onclick:preventDefault @onclick='() => SetView("StockExchange")'>
                <span class="nav-icon">🏢</span> <span>@Loc["nav.stock_exchange"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "StockMarket" ? "active" : "")" href="#" @onclick:preventDefault @onclick='() => SetView("StockMarket")'>
                <span class="nav-icon">📈</span> <span>@Loc["nav.stock_market"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "TradeListings" ? "active" : "")" href="#" @onclick:preventDefault @onclick='() => SetView("TradeListings")'>
