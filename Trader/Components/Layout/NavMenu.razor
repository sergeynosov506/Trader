@inject EconomicGame.Services.NavigationStateService NavState
@inject LocalizationService Loc
@implements IDisposable

<div class="top-row ps-3 pe-3 navbar navbar-dark d-flex justify-content-between align-items-center">
    <div class="container-fluid d-flex justify-content-between align-items-center p-0">
        <a class="navbar-brand m-0" href="#" @onclick:preventDefault @onclick='() => SetView("Market")'>@Loc["app.title"]</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="nav-scrollable @NavMenuCssClass">
    <nav class="nav flex-column">
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "Market" ? "active" : "")" href="#" @onclick='() => SetView("Market")'>
                <span class="nav-icon">📈</span> <span>@Loc["nav.market"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "StockExchange" ? "active" : "")" href="#" @onclick='() => SetView("StockExchange")'>
                <span class="nav-icon">🏢</span> <span>@Loc["nav.stock_exchange"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "StockMarket" ? "active" : "")" href="#" @onclick='() => SetView("StockMarket")'>
                <span class="nav-icon">📊</span> <span>@Loc["nav.stock_market"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "TradeListings" ? "active" : "")" href="#" @onclick='() => SetView("TradeListings")'>
                <span class="nav-icon">📋</span> <span>@Loc["nav.trade_listings"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "Bank" ? "active" : "")" href="#" @onclick='() => SetView("Bank")'>
                <span class="nav-icon">🏦</span> <span>@Loc["nav.bank"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "Housing" ? "active" : "")" href="#" @onclick='() => SetView("Housing")'>
                <span class="nav-icon">🏠</span> <span>@Loc["nav.housing"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "Logistics" ? "active" : "")" href="#" @onclick='() => SetView("Logistics")'>
                <span class="nav-icon">🚚</span> <span>@Loc["nav.logistics"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "Production" ? "active" : "")" href="#" @onclick='() => SetView("Production")'>
                <span class="nav-icon">🏭</span> <span>@Loc["nav.production"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "Inventory" ? "active" : "")" href="#" @onclick='() => SetView("Inventory")'>
                <span class="nav-icon">🎒</span> <span>@Loc["nav.inventory"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "Bar" ? "active" : "")" href="#" @onclick='() => SetView("Bar")'>
                <span class="nav-icon">🍺</span> <span>@Loc["nav.bar"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "Poker" ? "active" : "")" href="#" @onclick='() => SetView("Poker")'>
                <span class="nav-icon">♠️</span> <span>@Loc["nav.poker"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "Events" ? "active" : "")" href="#" @onclick='() => SetView("Events")'>
                <span class="nav-icon">📜</span> <span>@Loc["nav.events"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "Scenarios" ? "active" : "")" href="#" @onclick='() => SetView("Scenarios")'>
                <span class="nav-icon">🏁</span> <span>@Loc["nav.scenarios"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "Save" ? "active" : "")" href="#" @onclick='() => SetView("Save")'>
                <span class="nav-icon">💾</span> <span>@Loc["nav.save"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "AIPlayers" ? "active" : "")" href="#" @onclick='() => SetView("AIPlayers")'>
                <span class="nav-icon">🤖</span> <span>@Loc["nav.ai_traders"]</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link @(NavState.CurrentView == "Profile" ? "active" : "")" href="#" @onclick='() => SetView("Profile")'>
                <span class="nav-icon">👤</span> <span>@Loc["nav.profile"]</span>
            </a>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    protected override void OnInitialized()
    {
        Loc.OnLanguageChanged += Refresh;
        NavState.OnViewChanged += HandleViewChanged;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void HandleViewChanged(string view)
    {
        InvokeAsync(StateHasChanged);
    }

    private void SetView(string view)
    {
        NavState.CurrentView = view;
        collapseNavMenu = true;
    }

    public void Dispose()
    {
        Loc.OnLanguageChanged -= Refresh;
        NavState.OnViewChanged -= HandleViewChanged;
    }
}
