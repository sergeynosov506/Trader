@page "/"
@using Trader.Components.Layout
@inject EconomicGame.Services.GameEngine GameEngine
@inject EconomicGame.Services.PlayerService PlayerService
@inject EconomicGame.Services.StockMarketService StockMarketService
@inject EconomicGame.Services.CorporateRivalryService RivalryService
@inject EconomicGame.Services.NavigationStateService NavState
@inject LocalizationService Loc
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="container-fluid p-0">
    @if (_player == null)
    {
        <!-- Character Creation / Welcome Card -->
        <div class="row justify-content-center mt-4 mt-md-5">
            <div class="col-12 col-md-6 col-lg-5">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="card-header text-white p-4 text-center" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
                        <div class="fs-1 mb-2">🏙️</div>
                        <h2 class="fw-bold mb-1">@Loc["home.welcome"]</h2>
                        <p class="text-white-50 small mb-0">Economic Simulation & AI Rivalry</p>
                    </div>
                    <div class="card-body p-4">
                        <h5 class="fw-semibold mb-3">@Loc["home.enter_name"]</h5>
                        <div class="mb-3">
                            <input @bind="_playerName"
                                   @bind:event="oninput"
                                   @onkeyup="@(async e => { if (e.Key == "Enter") await CreatePlayer(); })"
                                   placeholder="@Loc["home.player_name"]" 
                                   class="form-control form-control-lg" />
                        </div>
                        <button @onclick="CreatePlayer" 
                                class="btn btn-primary btn-lg w-100 fw-bold shadow-sm"
                                disabled="@(string.IsNullOrWhiteSpace(_playerName))">
                            🚀 @Loc["home.start_playing"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- High-Priority Alerts (Sabotage) -->
        @if (_player.IsSabotaged)
        {
            <div class="alert alert-danger p-3 mb-3 shadow-sm rounded-3">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="fs-5">🚨</span>
                    <strong class="h6 mb-0">@Loc["home.ops_blocked"]</strong>
                </div>
                <p class="mb-1 small">@Loc["home.ops_blocked_desc"]</p>
                @if (_player.SabotageEndTime.HasValue)
                {
                    <small class="text-muted">@Loc["home.ops_recovery"]: @_player.SabotageEndTime.Value.ToString("t")</small>
                }
            </div>
        }

        <!-- Compact News Ticker Banner -->
        @if (GameEngine.LatestNews != null)
        {
            <div class="news-banner d-flex align-items-center gap-2 px-3 py-2 mb-3 bg-white border rounded-3 shadow-sm">
                <span class="badge bg-primary text-white text-uppercase" style="font-size: 0.7rem;">📰 News</span>
                <div class="news-text small flex-grow-1 text-truncate">
                    <strong>@GameEngine.LatestNews.Title</strong>: @GameEngine.LatestNews.Content
                </div>
                <span class="text-muted small d-none d-sm-inline">@GameEngine.LatestNews.Timestamp.ToShortTimeString()</span>
            </div>
        }

        <!-- Active Game View Container -->
        <div class="game-area">
            @if (CurrentView == "Market")
            {
                <MarketView Player="@_player" ExchangeItems="@GameEngine.ExchangeItems" />
            }
            else if (CurrentView == "StockExchange")
            {
                <StockExchangeView Items="@GameEngine.ExchangeItems" Player="@_player" />
            }
            else if (CurrentView == "Bank")
            {
                <BankView Player="@_player" />
            }
            else if (CurrentView == "TradeListings")
            {
                <TradeListingsView Player="@_player" />
            }
            else if (CurrentView == "Housing")
            {
                <HousingView Player="@_player" />
            }
            else if (CurrentView == "Logistics")
            {
                <LogisticsView Player="@_player" />
            }
            else if (CurrentView == "Production")
            {
                <ProductionView Player="@_player" />
            }
            else if (CurrentView == "StockMarket")
            {
                <StockMarketView Player="@_player" />
            }
            else if (CurrentView == "Bar")
            {
                <BarView Player="@_player" />
            }
            else if (CurrentView == "Poker")
            {
                <PokerView Player="@_player" />
            }
            else if (CurrentView == "Inventory")
            {
                <InventoryView Player="@_player" />
            }
            else if (CurrentView == "Events")
            {
                <EventsView Player="@_player" />
            }
            else if (CurrentView == "Scenarios")
            {
                <ScenariosView Player="@_player" />
            }
            else if (CurrentView == "Save")
            {
                <SaveView Player="@_player" />
            }
            else if (CurrentView == "AIPlayers")
            {
                <AIPlayersView />
            }
            else if (CurrentView == "Profile")
            {
                <ProfileView Player="@_player" />
            }
            else
            {
                <div class="alert alert-info">@Loc["home.select_section"]</div>
            }
        </div>

        <!-- Collapsible Market Activity Log -->
        @if (GameEngine.MarketActivityLog.Any())
        {
            <details class="activity-accordion mt-4 bg-white border rounded-3 shadow-sm">
                <summary class="px-3 py-2 fw-semibold text-secondary user-select-none d-flex align-items-center justify-content-between cursor-pointer">
                    <span class="d-flex align-items-center gap-2 small">
                        <span>📋</span>
                        <span>@Loc["home.market_activity"]</span>
                        <span class="badge bg-secondary-subtle text-secondary small">@GameEngine.MarketActivityLog.Count</span>
                    </span>
                </summary>
                <div class="p-3 border-top bg-light-subtle">
                    <ul class="list-unstyled mb-0 small" style="max-height: 180px; overflow-y: auto;">
                        @foreach (var log in GameEngine.MarketActivityLog)
                        {
                            <li class="border-bottom border-secondary border-opacity-10 py-1">@log</li>
                        }
                    </ul>
                </div>
            </details>
        }
    }
</div>

@code {
    private string CurrentView { get; set; } = "Market";
    private EconomicGame.Player? _player;
    private string _playerName = "";

    protected override void OnInitialized()
    {
        _player = PlayerService.GetCurrentPlayer();
        CurrentView = NavState.CurrentView;
        GameEngine.OnStateChanged += HandleStateChanged;
        Loc.OnLanguageChanged += HandleStateChanged;
        NavState.OnViewChanged += HandleViewChanged;
    }

    private void HandleStateChanged()
    {
        // Re-fetch player to get updates (especially after load)
        _player = PlayerService.GetCurrentPlayer();
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var savedName = await JS.InvokeAsync<string>("localStorage.getItem", "trader_player_name");
                if (!string.IsNullOrWhiteSpace(savedName))
                {
                    _playerName = savedName;
                    StateHasChanged();
                }
            }
            catch
            {
                // Ignore JS Interop errors during prerendering or other conditions
            }
        }
    }

    private async Task CreatePlayer()
    {
        if (!string.IsNullOrWhiteSpace(_playerName))
        {
            try
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "trader_player_name", _playerName);
            }
            catch
            {
                // Ignore JS Interop errors
            }

            _player = PlayerService.GetOrCreatePlayer(_playerName);
            GameEngine.SetCurrentTime(DateTime.Today.AddHours(8));
            StateHasChanged();
        }
    }

    private void HandleViewChanged(string view)
    {
        CurrentView = view;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameEngine.OnStateChanged -= HandleStateChanged;
        Loc.OnLanguageChanged -= HandleStateChanged;
        NavState.OnViewChanged -= HandleViewChanged;
    }
}
