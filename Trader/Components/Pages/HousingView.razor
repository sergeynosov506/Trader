@using EconomicGame
@using EconomicGame.Configuration
@inject EconomicGame.Services.GameEngine GameEngine
@inject LocalizationService Loc
@implements IDisposable

<div class="housing">
    <h2>@Loc["house.title"]</h2>

    @if (Player == null)
    {
        <p>@Loc["house.create_character"]</p>
    }
    else
    {
        <div class="row mb-4">
            <!-- Current housing status -->
            <div class="col-md-8">
                <div class="card @(!Player.Properties.Any() ? "border-warning" : "border-success") shadow-sm">
                    <div class="card-header @(!Player.Properties.Any() ? "bg-warning text-dark" : "bg-success text-white")">
                        <h5 class="mb-0">🏡 @Loc["house.your_homes"]</h5>
                    </div>
                    <div class="card-body">
                        @if (!Player.Properties.Any())
                        {
                            <div class="text-center py-3">
                                <h1>🚗</h1>
                                <h4>@Loc["house.homeless"]</h4>
                                <p class="text-muted">@Loc["house.sleep_in_car"]</p>
                                <div class="alert alert-warning">
                                    @Loc["house.homeless_warning"]
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead>
                                        <tr>
                                            <th>@Loc["house.name"]</th>
                                            <th>@Loc["house.rent"]</th>
                                            <th>@Loc["house.capacity"]</th>
                                            <th>@Loc["house.birthday_bonus"]</th>
                                            <th>@Loc["house.until_rent"]</th>
                                            <th>@Loc["house.action"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var property in Player.Properties)
                                        {
                                            var info = EconomicGame.Services.GameEngine.AvailableProperties.FirstOrDefault(p => p.Type == property.Type);
                                            var emoji = info != default ? info.Emoji : "🏡";
                                            var daysSinceRent = (GameEngine.CurrentTime - property.LastRentPaid).Days;
                                            var daysUntilRent = GameConstants.RentDueGameDays - daysSinceRent;
                                            <tr>
                                                <td class="fw-bold">@emoji @Loc.Entity(property.Name)</td>
                                                <td>@property.MonthlyRent.ToString("C")</td>
                                                <td>@property.GuestCapacity @Loc["house.guests_short"]</td>
                                                <td class="text-success">+@property.BirthdayGiftBonus.ToString("C")</td>
                                                <td>
                                                    <span class="badge @(daysUntilRent <= 5 ? "bg-danger" : "bg-info")">
                                                        @daysUntilRent @Loc["house.days"]
                                                    </span>
                                                </td>
                                                <td>
                                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => SellPropertySpecific(property)">
                                                        @Loc["house.sell_70"]
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Player stats -->
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">💰 @Loc["house.finances"]</h5>
                    </div>
                    <div class="card-body d-flex flex-column justify-content-center">
                        <p class="mb-2"><strong>@Loc["house.money"]:</strong> <span class="text-success fw-bold">@Player.Money.ToString("C")</span></p>
                        <p class="mb-2"><strong>@Loc["house.reputation"]:</strong> @Player.Reputation / 100</p>
                        <p class="mb-0"><strong>@Loc["house.total_homes"]:</strong> @Player.Properties.Count</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Message -->
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @_messageClass mb-4">@_message</div>
        }

        <!-- Available properties -->
        <h4>@Loc["house.available"]</h4>
        <div class="row">
            @foreach (var property in EconomicGame.Services.GameEngine.AvailableProperties)
            {
                var canAfford = Player.Money >= property.Price;
                var ownedCount = Player.Properties.Count(p => p.Type == property.Type);

                <div class="col-md-3 mb-3">
                    <div class="card h-100 @(ownedCount > 0 ? "border-success" : "") @(!canAfford ? "opacity-75" : "") shadow-sm">
                        <div class="card-header text-center bg-transparent border-0 pt-3">
                            <span style="font-size: 3rem;">@property.Emoji</span>
                        </div>
                        <div class="card-body text-center">
                            <h5>@Loc.Entity(property.Name)</h5>
                            @if (ownedCount > 0)
                            {
                                <span class="badge bg-success mb-2">@Loc["log.owned_count"]: @ownedCount</span>
                            }
                            <p class="text-primary fw-bold fs-5">@property.Price.ToString("C")</p>
                            <hr class="my-2" />
                            <p class="small mb-1">
                                <span class="text-muted">@Loc["house.rent"]:</span> @property.Rent.ToString("C")@Loc["house.per_month_short"]
                            </p>
                            <p class="small mb-1">
                                <span class="text-muted">@Loc["house.guests"]:</span> @property.Capacity @Loc["house.guests_short"]
                            </p>
                            <p class="small mb-1">
                                <span class="text-muted">@Loc["house.birthday_gifts"]:</span> +@property.BirthdayBonus.ToString("C")
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3">
                            @if (!canAfford)
                            {
                                <button class="btn btn-outline-secondary btn-sm w-100" disabled>
                                    @string.Format(Loc["house.not_enough"], (property.Price - Player.Money).ToString("C"))
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-primary btn-sm w-100"
                                        @onclick="() => BuyProperty(property.Type)">
                                    @Loc["house.buy"]
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Info about birthday -->
        <div class="card mt-4 bg-light">
            <div class="card-body">
                <h5>@Loc["house.birthday_info_title"]</h5>
                <p class="mb-0">
                    @Loc["house.birthday_info_body"]
                </p>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Player? Player { get; set; }

    private string _message = "";
    private string _messageClass = "alert-info";

    protected override void OnInitialized()
    {
        Loc.OnLanguageChanged += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Loc.OnLanguageChanged -= Refresh;
    }

    private void BuyProperty(PropertyType propertyType)
    {
        if (Player == null) return;

        var result = GameEngine.BuyProperty(Player, propertyType);
        _message = result;
        // Service returns Russian; detect success by Russian stem
        _messageClass = result.Contains("Поздравляем") ? "alert-success" : "alert-danger";
        StateHasChanged();
    }

    private void SellProperty()
    {
        if (Player == null) return;

        var result = GameEngine.SellProperty(Player);
        _message = result;
        _messageClass = result.Contains("Продал") ? "alert-success" : "alert-danger";
        StateHasChanged();
    }

    private void SellPropertySpecific(Property property)
    {
        if (Player == null || property == null) return;

        var result = GameEngine.SellProperty(Player, property);
        _message = result;
        _messageClass = result.Contains("Продал") || result.Contains("Sold") ? "alert-success" : "alert-danger";
        StateHasChanged();
    }
}
