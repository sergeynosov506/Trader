@using EconomicGame
@using EconomicGame.Configuration
@using EconomicGame.Models
@inject EconomicGame.Services.GameEngine GameEngine
@inject LocalizationService Loc
@implements IDisposable

<div class="logistics animate-fade-in">
    <h2>@Loc["log.title"]</h2>

    @if (Player == null)
    {
        <p>@Loc["log.create_character"]</p>
    }
    else
    {
        <!-- Sub-navigation Tabs -->
        <div class="d-flex flex-wrap gap-2 mb-4 bg-light p-2 rounded shadow-sm border border-secondary-subtle">
            <button class='btn @(_activeTab == "status" ? "btn-primary" : "btn-outline-dark")' 
                    @onclick='() => _activeTab = "status"'>
                📊 @Loc["log.current_assets"]
            </button>
            <button class='btn @(_activeTab == "vehicles" ? "btn-primary" : "btn-outline-dark")' 
                    @onclick='() => _activeTab = "vehicles"'>
                🚗 @Loc["log.transport_h"]
            </button>
            <button class='btn @(_activeTab == "realestate" ? "btn-primary" : "btn-outline-dark")' 
                    @onclick='() => _activeTab = "realestate"'>
                🏞 @Loc["log.warehouses_title"]
            </button>
            <button class='btn @(_activeTab == "upgrades" ? "btn-primary" : "btn-outline-dark")' 
                    @onclick='() => _activeTab = "upgrades"'>
                🏢 @Loc["log.industrial_title"]
            </button>
        </div>

        <!-- Message Alert (shared across all tabs) -->
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @_messageClass alert-dismissible fade show mb-4 shadow-sm" role="alert">
                @_message
                <button type="button" class="btn-close" @onclick="() => _message = string.Empty" aria-label="Close"></button>
            </div>
        }

        @if (_activeTab == "status")
        {
            <!-- Status overview -->
            <div class="row mb-4">
                <div class="col-md-4 mb-3">
                    <div class="card @(Player.Vehicle == null ? "border-warning border-2" : "border-success border-2") shadow-sm h-100">
                        <div class="card-header bg-success text-white py-2">
                            <h5 class="mb-0 fs-6">📊 @Loc["log.capacity"]</h5>
                        </div>
                        <div class="card-body text-center d-flex flex-column justify-content-center">
                            <h3 class="mb-2">@Player.CurrentCargoUsed / @Player.TotalCargoCapacity</h3>
                            <div class="progress my-2" style="height: 20px;">
                                @{
                                    var usagePercent = Player.TotalCargoCapacity > 0
                                        ? (double)Player.CurrentCargoUsed / Player.TotalCargoCapacity * 100
                                        : 0;
                                    var progressClass = usagePercent > 90 ? "bg-danger" : usagePercent > 70 ? "bg-warning" : "bg-success";
                                }
                                <div class="progress-bar @progressClass" style="width: @usagePercent%;">
                                    @($"{usagePercent:F0}%")
                                </div>
                            </div>
                            <p class="mb-0 small text-muted">
                                @Loc["log.free_short"]: <strong>@Player.AvailableCargoSpace</strong> @Loc["inv.units"]
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100 border-2 border-primary-subtle">
                        <div class="card-header bg-primary text-white py-2">
                            <h5 class="mb-0 fs-6">💰 @Loc["log.finance"]</h5>
                        </div>
                        <div class="card-body d-flex flex-column justify-content-center text-center">
                            <span class="text-muted small">@Loc["log.money"]</span>
                            <h2 class="text-success my-2">@Player.Money.ToString("C")</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100 border-2 border-dark-subtle">
                        <div class="card-header bg-dark text-white py-2">
                            <h5 class="mb-0 fs-6">📦 @Loc["log.current_assets"]</h5>
                        </div>
                        <div class="card-body small py-2 d-flex flex-column justify-content-center">
                            <div class="mb-1">
                                <strong>@Loc["log.transport"]:</strong>
                                @if (Player.Vehicles != null && Player.Vehicles.Any())
                                {
                                    <span>@string.Join(", ", Player.Vehicles.Select(v => $"{v.Emoji} {Loc.Entity(v.Name)}"))</span>
                                }
                                else
                                {
                                    <span>@Loc["log.no"]</span>
                                }
                            </div>
                            <div class="mb-1">
                                <strong>@Loc["log.land"]:</strong>
                                @if (Player.Lands != null && Player.Lands.Any())
                                {
                                    <span>@string.Join(", ", Player.Lands.Select(l => $"{l.Emoji} {Loc[$"land.{l.Type.ToString().ToLower()}"]}"))</span>
                                }
                                else
                                {
                                    <span>@Loc["log.no"]</span>
                                }
                            </div>
                            <div class="mb-1">
                                <strong>@Loc["log.warehouses_h"]:</strong>
                                @if (Player.Warehouses.Any())
                                {
                                    <span>@Player.Warehouses.Count / @Player.MaxWarehouses (@string.Join(", ", Player.Warehouses.Select(w => $"{w.Emoji} {Loc.Entity(w.Name)}")))</span>
                                }
                                else
                                {
                                    <span>@Loc["log.no"]</span>
                                }
                            </div>
                            <div class="mb-0">
                                <strong>@Loc["log.license_active_level"]:</strong>
                                @if (Player.TradingLicenseLevel > 0)
                                {
                                    <span class="badge bg-success">@Loc["log.level_short"] @Player.TradingLicenseLevel</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@Loc["log.none"]</span>
                                }
                            </div>
                            @if (Player.Factories.Any())
                            {
                                <div class="mt-1"><strong>@Loc["log.factories_list"]:</strong> @string.Join(", ", Player.Factories.Select(f => f.Emoji))</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Info / Help -->
            <div class="card bg-light border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title text-primary mb-3">ℹ️ @Loc["log.info_title"]</h5>
                    <div class="list-group list-group-flush bg-transparent">
                        <div class="list-group-item bg-transparent px-0 py-2 border-0 small">👉 @Loc["log.info_1"]</div>
                        <div class="list-group-item bg-transparent px-0 py-2 border-0 small">👉 @Loc["log.info_2"]</div>
                        <div class="list-group-item bg-transparent px-0 py-2 border-0 small">👉 @Loc["log.info_3"]</div>
                        <div class="list-group-item bg-transparent px-0 py-2 border-0 small">👉 @Loc["log.info_4"]</div>
                        <div class="list-group-item bg-transparent px-0 py-2 border-0 small">👉 @Loc["log.info_5"]</div>
                    </div>
                </div>
            </div>
        }
        else if (_activeTab == "vehicles")
        {
            <!-- Vehicles -->
            <div>
                <!-- My Fleet Section -->
                <div class="bg-light p-3 rounded mb-3 border shadow-sm">
                    <h4 class="mb-1 text-primary">🚢 @Loc["log.my_fleet"]</h4>
                    <p class="text-muted small mb-0">@Loc["log.my_fleet_desc"]</p>
                </div>

                @if (Player.Vehicles.Any())
                {
                    <div class="row mb-4">
                        @foreach (var ownedVehicle in Player.Vehicles)
                        {
                            <div class="col-md-3 mb-3">
                                <div class="card border border-success bg-success-subtle shadow-sm h-100 border-2">
                                    <div class="card-header bg-transparent border-0 pt-3 text-center">
                                        <span style="font-size: 3rem;">@ownedVehicle.Emoji</span>
                                    </div>
                                    <div class="card-body text-center py-2">
                                        <h5 class="card-title text-success-emphasis">@Loc.Entity(ownedVehicle.Name)</h5>
                                        <p class="small mb-1"><strong>@Loc["log.capacity_wh"]:</strong> @ownedVehicle.CargoCapacity @Loc["inv.units"]</p>
                                        <p class="small text-muted mb-3"><strong>@Loc["log.bought_for"]:</strong> @ownedVehicle.PurchasePrice.ToString("C")</p>
                                        <button class="btn btn-outline-danger btn-sm w-100" @onclick="() => SellVehicleSpecific(ownedVehicle)">
                                            @Loc["log.sell_60_pct"]
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-4 shadow-sm">
                        🚗 @Loc["log.no_vehicles"]
                    </div>
                }

                <!-- Available Vehicles Section -->
                <div class="bg-light p-3 rounded mb-3 border shadow-sm">
                    <h4 class="mb-1 text-primary">🛒 @Loc["log.available_vehicles"]</h4>
                    <p class="text-muted small mb-0">@Loc["log.buy_more_vehicles_desc"]</p>
                </div>
                <div class="row">
                    @foreach (var vehicle in EconomicGame.Services.GameEngine.AvailableVehicles)
                    {
                        var ownedCount = Player.Vehicles.Count(v => v.Type == vehicle.Type);
                        var canAfford = Player.Money >= vehicle.Price;

                        <div class="col-md-3 mb-4">
                            <div class="card h-100 text-center shadow-sm border-0 border-top border-4 border-primary">
                                <div class="card-header bg-transparent border-0 pt-3">
                                    <span style="font-size: 3rem;">@vehicle.Emoji</span>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title text-dark">@Loc.Entity(vehicle.Name)</h5>
                                    @if (ownedCount > 0)
                                    {
                                        <span class="badge bg-success mb-2">@Loc["log.owned_count"]: @ownedCount</span>
                                    }
                                    <p class="text-primary fw-bold fs-5 mb-2">@vehicle.Price.ToString("C")</p>
                                    <p class="small text-muted mb-0">@Loc["log.capacity"]: <strong>@vehicle.Capacity</strong> @Loc["inv.units"]</p>
                                </div>
                                <div class="card-footer bg-transparent border-0 pb-3">
                                    @if (!canAfford)
                                    {
                                        <button class="btn btn-secondary btn-sm w-100" disabled>
                                            @Loc["log.not_enough"]
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-primary btn-sm w-100"
                                                @onclick="() => BuyVehicle(vehicle.Type)">
                                            @Loc["log.buy"]
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (_activeTab == "realestate")
        {
            <!-- Real Estate / Land Plots & Warehouses -->
            <div>
                <!-- My Land Plots Section -->
                <div class="bg-light p-3 rounded mb-3 border shadow-sm">
                    <h4 class="mb-1 text-primary">🏕️ @Loc["log.my_land_plots"] (@Player.Lands.Count / @Player.MaxLandPlots)</h4>
                    <p class="text-muted small mb-0">@Loc["log.my_land_plots_desc"]</p>
                </div>
                
                @if (Player.Lands.Any())
                {
                    <div class="row mb-4">
                        @foreach (var ownedLand in Player.Lands)
                        {
                            var localizedName = Loc[$"land.{ownedLand.Type.ToString().ToLower()}"];
                            var sellPrice = ownedLand.PurchasePrice * 0.7m;
                            var remainingLands = Player.Lands.Where(l => l.Id != ownedLand.Id).ToList();
                            var canSell = true;
                            var sellWarning = "";
                            
                            if (Player.Warehouses.Any() && !remainingLands.Any())
                            {
                                canSell = false;
                                sellWarning = Loc["log.sell_warehouses_first"];
                            }
                            else if (Player.Factories.Any() && !remainingLands.Any())
                            {
                                canSell = false;
                                sellWarning = Loc.CurrentLanguage == EconomicGame.Services.Language.Ru 
                                    ? "Сначала продайте заводы!" 
                                    : "Sell factories first!";
                            }
                            else
                            {
                                foreach (var wh in Player.Warehouses)
                                {
                                    var whInfo = EconomicGame.Services.GameEngine.AvailableWarehouses.FirstOrDefault(w => w.Type == wh.Type);
                                    var reqLevel = whInfo != default ? whInfo.RequiredLandLevel : 1;
                                    if (!remainingLands.Any(l => l.MaxWarehouseLevel >= reqLevel))
                                    {
                                        canSell = false;
                                        sellWarning = Loc.CurrentLanguage == EconomicGame.Services.Language.Ru
                                            ? $"Склад {wh.Name} требует ур. {reqLevel}"
                                            : $"Wh {Loc.Entity(wh.Name)} requires lv. {reqLevel}";
                                        break;
                                    }
                                }
                            }

                            <div class="col-md-4 mb-3">
                                <div class="card border border-success bg-success-subtle shadow-sm h-100 border-2">
                                    <div class="card-header bg-transparent border-0 pt-3 text-center">
                                        <span style="font-size: 3rem;">@ownedLand.Emoji</span>
                                    </div>
                                    <div class="card-body text-center py-2">
                                        <h5 class="card-title text-success-emphasis">@localizedName</h5>
                                        <p class="small mb-1"><strong>@Loc["log.max_wh_level"]:</strong> @ownedLand.MaxWarehouseLevel</p>
                                        <p class="small text-muted mb-3"><strong>@Loc["log.bought_for"]:</strong> @ownedLand.PurchasePrice.ToString("C")</p>
                                        
                                        @if (canSell)
                                        {
                                            <button class="btn btn-outline-danger btn-sm w-100" @onclick="() => SellLandSpecific(ownedLand.Id)">
                                                @Loc["log.sell_70_pct"] (@sellPrice.ToString("C"))
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-secondary btn-sm w-100" disabled title="@sellWarning">
                                                🔒 @sellWarning
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-4 shadow-sm">
                        @Loc["log.no_lands"]
                    </div>
                }

                <!-- Available Plots Section -->
                <div class="bg-light p-3 rounded mb-3 border shadow-sm">
                    <h4 class="mb-1 text-primary">🛒 @Loc["log.land_title"]</h4>
                    <p class="text-muted small mb-0">@Loc["log.land_desc"]</p>
                </div>
                <div class="row mb-4">
                    @foreach (var land in EconomicGame.Services.GameEngine.AvailableLand)
                    {
                        var ownedCount = Player.Lands.Count(l => l.Type == land.Type);
                        var canAfford = Player.Money >= land.Price;
                        var atLimit = Player.Lands.Count >= Player.MaxLandPlots;
                        var localizedLandName = Loc[$"land.{land.Type.ToString().ToLower()}"];

                        <div class="col-md-4 mb-4">
                            <div class="card h-100 text-center shadow-sm border-0 border-top border-4 border-primary">
                                <div class="card-header bg-transparent border-0 pt-3">
                                    <span style="font-size: 3rem;">@land.Emoji</span>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title text-dark">@localizedLandName</h5>
                                    @if (ownedCount > 0)
                                    {
                                        <span class="badge bg-success mb-2">@Loc["log.owned_count"]: @ownedCount</span>
                                    }
                                    <p class="text-primary fw-bold fs-5 mb-2">@land.Price.ToString("C")</p>
                                    <p class="small text-muted mb-0">@Loc["log.max_wh_level"] <strong>@land.MaxWarehouse</strong></p>
                                </div>
                                <div class="card-footer bg-transparent border-0 pb-3">
                                    @if (atLimit)
                                    {
                                        <span class="badge bg-warning text-dark w-100 p-2">@Loc["log.land_limit"]</span>
                                    }
                                    else if (!canAfford)
                                    {
                                        <button class="btn btn-secondary btn-sm w-100" disabled>
                                            @Loc["log.not_enough"]
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-primary btn-sm w-100"
                                                @onclick="() => BuyLand(land.Type)">
                                            @Loc["log.buy"]
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Warehouses Section -->
                <div class="bg-light p-3 rounded mb-3 border shadow-sm">
                    <h4 class="mb-1 text-primary">@Loc["log.warehouses_title"] (@Player.Warehouses.Count / @Player.MaxWarehouses)</h4>
                    <p class="text-muted small mb-0">@Loc["log.warehouses_desc"]</p>
                </div>

                @if (Player.Warehouses.Any())
                {
                    <div class="row mb-4">
                        @foreach (var ownedWarehouse in Player.Warehouses)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card border border-success bg-success-subtle shadow-sm h-100 border-2">
                                    <div class="card-body text-center py-3">
                                        <h5 class="card-title text-success-emphasis">@ownedWarehouse.Emoji @Loc.Entity(ownedWarehouse.Name)</h5>
                                        <p class="small mb-1"><strong>@Loc["log.capacity_wh"]:</strong> @ownedWarehouse.Capacity @Loc["inv.units"]</p>
                                        <p class="small text-warning-emphasis mb-3"><strong>@Loc["log.upkeep"]:</strong> @ownedWarehouse.MonthlyMaintenance.ToString("C") @Loc["log.per_month"]</p>
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => SellWarehouseById(ownedWarehouse.WarehouseId)">@Loc["log.sell_50_pct"]</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="row">
                    @foreach (var warehouse in EconomicGame.Services.GameEngine.AvailableWarehouses)
                    {
                        var canAfford = Player.Money >= warehouse.Price;
                        var hasLand = Player.Lands.Any();
                        var landSufficient = Player.Lands.Any(l => l.MaxWarehouseLevel >= warehouse.RequiredLandLevel);
                        var atLimit = Player.Warehouses.Count >= Player.MaxWarehouses;

                        <div class="col-md-4 mb-4">
                            <div class="card h-100 text-center shadow-sm border-0 border-top border-4 border-info">
                                <div class="card-header bg-transparent border-0 pt-3">
                                    <span style="font-size: 3rem;">@warehouse.Emoji</span>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title text-dark">@Loc.Entity(warehouse.Name)</h5>
                                    <p class="text-primary fw-bold fs-5 mb-2">@warehouse.Price.ToString("C")</p>
                                    <p class="small text-muted mb-1">@Loc["log.capacity_plus"]<strong>@warehouse.Capacity</strong> @Loc["inv.units"]</p>
                                    <p class="small text-warning-emphasis mb-1"><strong>@Loc["log.upkeep"]:</strong> @warehouse.Maintenance.ToString("C")@Loc["log.per_month"]</p>
                                    <p class="small text-info mb-0">@Loc["log.requires_plot"] @warehouse.RequiredLandLevel+</p>
                                </div>
                                <div class="card-footer bg-transparent border-0 pb-3">
                                    @if (!hasLand)
                                    {
                                        <span class="badge bg-secondary w-100 p-2">@Loc["log.buy_land_first"]</span>
                                    }
                                    else if (!landSufficient)
                                    {
                                        <span class="badge bg-warning text-dark w-100 p-2">@Loc["log.plot_too_small"]</span>
                                    }
                                    else if (atLimit)
                                    {
                                        <span class="badge bg-warning text-dark w-100 p-2">@Loc["log.wh_limit"]</span>
                                    }
                                    else if (!canAfford)
                                    {
                                        <button class="btn btn-secondary btn-sm w-100" disabled>
                                            @Loc["log.not_enough"]
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-primary btn-sm w-100"
                                                @onclick="() => BuyWarehouse(warehouse.Type)">
                                            @Loc["log.build"]
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (_activeTab == "upgrades")
        {
            <!-- Upgrades & Licenses (Factories & Licenses) -->
            <div>
                <!-- Industrial Factories -->
                <div class="bg-light p-3 rounded mb-3 border shadow-sm">
                    <h4 class="mb-1 text-primary">@Loc["log.industrial_title"]</h4>
                    <p class="text-muted small mb-0">@Loc["log.industrial_desc"]</p>
                </div>
                <div class="row mb-4">
                    @foreach (var factory in EconomicGame.Services.GameEngine.AvailableFactories)
                    {
                        var isOwned = Player.Factories.Any(f => f.Type == factory.Type);
                        var canAfford = Player.Money >= factory.Price;
                        var hasLand = Player.Lands.Any();

                        <div class="col-md-6 mb-4">
                            <div class="card h-100 text-center shadow-sm border-0 border-top border-4 @(isOwned ? "border-success bg-success-subtle" : "border-warning")">
                                <div class="card-header bg-transparent border-0 pt-3">
                                    <span style="font-size: 3rem;">@factory.Emoji</span>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title text-dark">@Loc.Entity(factory.Name)</h5>
                                    <p class="text-primary fw-bold fs-5 mb-2">@factory.Price.ToString("C")</p>
                                    <p class="small text-muted mb-1"><strong>@Loc["log.target"]:</strong> @factory.TargetRecipe</p>
                                    <p class="small text-success fw-bold mb-1">@Loc["log.bonus"]</p>
                                    <p class="small text-warning-emphasis mb-0"><strong>@Loc["log.upkeep"]:</strong> @factory.Maintenance.ToString("C")@Loc["log.per_month"]</p>
                                </div>
                                <div class="card-footer bg-transparent border-0 pb-3">
                                    @if (isOwned)
                                    {
                                        <span class="badge bg-success w-100 p-2">@Loc["log.built"]</span>
                                    }
                                    else if (!hasLand)
                                    {
                                        <span class="badge bg-secondary w-100 p-2">@Loc["log.need_land"]</span>
                                    }
                                    else if (!canAfford)
                                    {
                                        <button class="btn btn-secondary btn-sm w-100" disabled>
                                            @Loc["log.not_enough"]
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-success btn-sm w-100"
                                                @onclick="() => BuyFactory(factory.Type)">
                                            @Loc["log.build_factory"]
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Trading Licenses -->
                <div class="bg-light p-3 rounded mb-3 border shadow-sm">
                    <h4 class="mb-1 text-primary">@Loc["log.license_title"]</h4>
                    <p class="text-muted small mb-0">@Loc["log.license_desc"] @Loc["log.current_level"]: <strong>@Player.TradingLicenseLevel</strong> (@Loc["log.max_wh"]: <strong>@Player.MaxWarehouses</strong>)</p>
                </div>
                <div class="row">
                    @{
                        var licenses = new[] {
                            (Level: 1, Name: Loc["log.basic"], Cost: GameConstants.TradingLicenseLevel1Cost, MaxWh: GameConstants.MaxWarehousesLevel1),
                            (Level: 2, Name: Loc["log.advanced"], Cost: GameConstants.TradingLicenseLevel2Cost, MaxWh: GameConstants.MaxWarehousesLevel2),
                            (Level: 3, Name: Loc["log.master"], Cost: GameConstants.TradingLicenseLevel3Cost, MaxWh: GameConstants.MaxWarehousesLevel3)
                        };
                    }
                    @foreach (var lic in licenses)
                    {
                        var isOwned = Player.TradingLicenseLevel >= lic.Level;
                        var canBuy = Player.TradingLicenseLevel == lic.Level - 1 && Player.Money >= lic.Cost;
                        
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 text-center shadow-sm border-0 border-top border-4 @(isOwned ? "border-success bg-success-subtle" : "border-primary")">
                                <div class="card-header bg-transparent border-0 pt-3">
                                    <span style="font-size: 3rem;">🎫</span>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title text-dark">@lic.Name (@Loc["log.level_short"] @lic.Level)</h5>
                                    <p class="text-primary fw-bold fs-5 mb-2">@lic.Cost.ToString("C")</p>
                                    <p class="small text-muted mb-0"><strong>@Loc["log.max_wh"]:</strong> @lic.MaxWh</p>
                                </div>
                                <div class="card-footer bg-transparent border-0 pb-3">
                                    @if (isOwned)
                                    {
                                        <span class="badge bg-success w-100 p-2">@Loc["log.active"]</span>
                                    }
                                    else if (canBuy)
                                    {
                                        <button class="btn btn-primary btn-sm w-100" @onclick="() => BuyLicense(lic.Level)">@Loc["log.buy"]</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary btn-sm w-100" disabled>@(Player.TradingLicenseLevel < lic.Level - 1 ? string.Format(Loc["log.buy_level_first"], lic.Level - 1) : Loc["log.not_enough"])</button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

