@using EconomicGame
@using EconomicGame.Models
@inject EconomicGame.Services.SaveGameService SaveService
@inject EconomicGame.Services.GameEngine GameEngine
@inject LocalizationService Loc
@implements IDisposable

<div class="save-load">
    <h2>@Loc["save.title"]</h2>

    @if (Player == null)
    {
        <div class="alert alert-warning">
            @Loc["save.create_character"]
        </div>
    }
    else
    {
        <!-- Save section -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5>@Loc["save.save_game"]</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">@Loc["save.name_label"]</label>
                            <input type="text" @bind="_saveName" class="form-control"
                                   placeholder="@Loc["save.name_placeholder"]" maxlength="50" />
                        </div>
                        <button class="btn btn-primary" @onclick="SaveGame">
                            @Loc["save.save_btn"]
                        </button>
                    </div>
                    <div class="col-md-6">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6>@Loc["save.progress"]</h6>
                                <p><strong>@Loc["save.player"]:</strong> @Player.Name</p>
                                <p><strong>@Loc["save.money"]:</strong> @Player.Money.ToString("C")</p>
                                <p><strong>@Loc["save.day"]:</strong> @(((GameEngine.CurrentTime - DateTime.Today).Days) + 1)</p>
                                <p><strong>@Loc["save.time"]:</strong> @GameEngine.CurrentTime.ToString("t")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Message -->
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @_messageClass mb-4">@_message</div>
        }

        <!-- Load section -->
        <div class="card">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@Loc["save.load_game"]</h5>
                <button class="btn btn-sm btn-outline-light" @onclick="RefreshSaves">
                    @Loc["save.refresh"]
                </button>
            </div>
            <div class="card-body">
                @if (!_saves.Any())
                {
                    <div class="alert alert-info">
                        @Loc["save.empty"]
                    </div>
                }
                else
                {
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>@Loc["save.col_name"]</th>
                                <th>@Loc["save.col_player"]</th>
                                <th>@Loc["save.col_day"]</th>
                                <th>@Loc["save.col_money"]</th>
                                <th>@Loc["save.col_saved_at"]</th>
                                <th>@Loc["save.col_actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var save in _saves)
                            {
                                <tr>
                                    <td><strong>@save.Data.SaveName</strong></td>
                                    <td>@save.Data.PlayerData?.Name</td>
                                    <td>@string.Format(Loc["save.day_n"], save.Data.GameDay)</td>
                                    <td>@(save.Data.PlayerData?.Money.ToString("C") ?? "-")</td>
                                    <td class="text-muted small">@save.Data.SavedAt.ToString("g")</td>
                                    <td>
                                        <button class="btn btn-sm btn-success me-1"
                                                @onclick="() => LoadGame(save.FileName)">
                                            @Loc["save.load_btn"]
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => DeleteSave(save.FileName)">
                                            🗑️
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="card mt-4 bg-light">
            <div class="card-body">
                <h6>@Loc["save.info_title"]</h6>
                <ul class="mb-0 small">
                    <li>@Loc["save.info_location"]<code>%APPDATA%\Trader\Saves\</code></li>
                    <li>@Loc["save.info_replace"]</li>
                    <li>@Loc["save.info_regular"]</li>
                </ul>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Player? Player { get; set; }

    private string _saveName = "";
    private string _message = "";
    private string _messageClass = "alert-info";
    private List<(string FileName, GameSaveData Data)> _saves = new();

    protected override void OnInitialized()
    {
        Loc.OnLanguageChanged += Refresh;
        RefreshSaves();
        _saveName = string.Format(Loc["save.default_name"], DateTime.Now.ToString("dd.MM.yyyy"));
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Loc.OnLanguageChanged -= Refresh;
    }

    private void RefreshSaves()
    {
        _saves = SaveService.GetSaveFiles();
        StateHasChanged();
    }

    private void SaveGame()
    {
        if (string.IsNullOrWhiteSpace(_saveName))
        {
            _message = Loc["save.name_required"];
            _messageClass = "alert-danger";
            return;
        }

        var result = SaveService.SaveGame(_saveName);
        _message = result;
        _messageClass = result.StartsWith("✅") ? "alert-success" : "alert-danger";
        RefreshSaves();
    }

    private void LoadGame(string fileName)
    {
        var result = SaveService.LoadGame(fileName);
        _message = result;
        _messageClass = result.StartsWith("✅") ? "alert-success" : "alert-danger";
        StateHasChanged();
    }

    private void DeleteSave(string fileName)
    {
        var result = SaveService.DeleteSave(fileName);
        _message = result;
        _messageClass = result.StartsWith("✅") ? "alert-success" : "alert-danger";
        RefreshSaves();
    }
}
