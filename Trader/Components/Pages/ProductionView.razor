@using EconomicGame
@using EconomicGame.Models
@inject EconomicGame.Services.GameEngine GameEngine
@inject LocalizationService Loc
@implements IDisposable

<div class="production">
    <h2>@Loc["prod.title"]</h2>

    @if (Player == null)
    {
        <p>@Loc["prod.create_character"]</p>
    }
    else if (Player.Warehouse == null)
    {
        <div class="alert alert-warning">
            <h5>@Loc["prod.need_warehouse"]</h5>
            <p>@Loc["prod.need_warehouse_desc"]</p>
        </div>
    }
    else
    {
        <!-- Sleek Dashboard Status Bar -->
        <div class="d-flex flex-wrap justify-content-between align-items-center bg-white p-2.5 rounded-3 shadow-sm border border-light-subtle mb-3" 
             style="backdrop-filter: blur(10px); background: rgba(255, 255, 255, 0.95); row-gap: 10px;">
            <div class="d-flex align-items-center gap-2.5">
                <div class="p-2 bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-size: 1.1rem;">
                    💰
                </div>
                <div>
                    <div class="text-muted small fw-semibold text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.5px;">@Loc["prod.balance"]</div>
                    <div class="h6 mb-0 fw-bold text-success" style="font-size: 0.95rem;">@Player.Money.ToString("C")</div>
                </div>
            </div>
            <div class="vr d-none d-md-block bg-secondary opacity-25" style="height: 25px;"></div>
            <div class="d-flex align-items-center gap-2.5">
                <div class="p-2 bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-size: 1.1rem;">
                    📦
                </div>
                <div>
                    <div class="text-muted small fw-semibold text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.5px;">@Loc["prod.warehouse"]</div>
                    <div class="h6 mb-0 fw-bold text-primary" style="font-size: 0.95rem;">
                        @Player.CurrentCargoUsed / @Player.TotalCargoCapacity
                        <span class="text-muted fw-normal" style="font-size: 0.75rem;">@Loc["inv.units"]</span>
                    </div>
                </div>
            </div>
            <div class="vr d-none d-md-block bg-secondary opacity-25" style="height: 25px;"></div>
            <div class="d-flex align-items-center gap-2.5">
                <div class="p-2 bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-size: 1.1rem;">
                    🏭
                </div>
                <div>
                    <div class="text-muted small fw-semibold text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.5px;">@Loc["inv.warehouse"]</div>
                    <div class="h6 mb-0 fw-bold text-dark" style="font-size: 0.95rem;">
                        @if (Player.Warehouses != null && Player.Warehouses.Any())
                        {
                            <span>@Player.Warehouses.Count @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "склада" : "warehouses")</span>
                        }
                        else
                        {
                            <span>@Loc["log.no"]</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Reference Inventory Badges (Inline Ribbon) -->
        <div class="bg-light p-2 rounded-3 border border-light-subtle mb-3 d-flex align-items-center flex-wrap gap-2" style="font-size: 0.8rem; background-color: #f8f9fa;">
            <span class="fw-bold text-muted d-flex align-items-center gap-1" style="font-size: 0.75rem;">
                📦 @Loc["prod.inventory_title"]:
            </span>
            @if (Player.Inventory.Any())
            {
                <div class="d-flex flex-wrap gap-1 align-items-center">
                    @foreach (var item in Player.Inventory)
                    {
                        <span class="badge bg-white text-dark border border-secondary-subtle px-2 py-1 shadow-2xs fw-semibold" style="font-size: 0.75rem;">
                            @item.ItemName: <span class="text-primary font-monospace">@item.Quantity</span>
                        </span>
                    }
                </div>
            }
            else
            {
                <span class="text-muted small italic">@Loc["prod.empty_inventory"]</span>
            }
        </div>

        <!-- Navigation Tabs & Category Filters -->
        <div class="d-flex justify-content-between align-items-center flex-wrap mb-3 gap-2">
            <ul class="nav nav-pills gap-1 p-1 bg-white rounded-3 shadow-2xs border border-light-subtle" style="width: fit-content; max-width: 100%;">
                <li class="nav-item">
                    <button class="nav-link btn-sm py-1 px-2.5 rounded-2 fw-semibold @(_activeTab == "all" ? "active bg-primary text-white" : "text-muted")" 
                            style="font-size: 0.75rem; transition: all 0.2s;" @onclick='() => SetActiveTab("all")'>
                        🌐 @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "Все" : "All")
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link btn-sm py-1 px-2.5 rounded-2 fw-semibold @(_activeTab == "food" ? "active bg-success text-white" : "text-muted")" 
                            style="font-size: 0.75rem; transition: all 0.2s;" @onclick='() => SetActiveTab("food")'>
                        🍎 @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "Еда и Энергия" : "Food & Fuel")
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link btn-sm py-1 px-2.5 rounded-2 fw-semibold @(_activeTab == "industry" ? "active bg-info text-white" : "text-muted")" 
                            style="font-size: 0.75rem; transition: all 0.2s;" @onclick='() => SetActiveTab("industry")'>
                        🏭 @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "Пром. товары" : "Industry")
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link btn-sm py-1 px-2.5 rounded-2 fw-semibold @(_activeTab == "luxury" ? "active bg-warning text-dark fw-bold" : "text-muted")" 
                            style="font-size: 0.75rem; transition: all 0.2s;" @onclick='() => SetActiveTab("luxury")'>
                        💎 @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "Люкс и Тех" : "High-Tech")
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link btn-sm py-1 px-2.5 rounded-2 fw-semibold @(_activeTab == "auto" ? "active bg-danger text-white" : "text-muted")" 
                            style="font-size: 0.75rem; transition: all 0.2s;" @onclick='() => SetActiveTab("auto")'>
                        🤖 @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "Автоматизация" : "Automation")
                        @if (Player.AutoProductionRecipes?.Any() == true)
                        {
                            <span class="badge bg-white text-danger ms-1 px-1 rounded-circle small">@Player.AutoProductionRecipes.Count</span>
                        }
                    </button>
                </li>
            </ul>
        </div>

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @_messageClass alert-dismissible fade show py-2 px-3 mb-3 small d-flex justify-content-between align-items-center">
                <span>@_message</span>
                <button type="button" class="btn-close relative p-0" style="top:0; right:0;" @onclick="() => _message = string.Empty" aria-label="Close"></button>
            </div>
        }

        <!-- Workspace Split Layout -->
        <div class="row g-3">
            <!-- Left Column: Master Recipe List -->
            <div class="col-md-5 col-lg-4">
                <div class="card shadow-2xs border border-light-subtle rounded-3 p-2 d-flex flex-column" 
                     style="background: #ffffff; height: 510px;">
                    <div class="text-muted fw-bold mb-2 px-1" style="font-size: 0.7rem; letter-spacing: 0.5px; text-transform: uppercase;">
                        📑 @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "Доступные рецепты" : "Recipes")
                    </div>
                    <div class="d-flex flex-column gap-2 overflow-y-auto px-1 flex-grow-1" style="max-height: 470px;">
                        @foreach (var recipe in ProductionRecipes.AllRecipes)
                        {
                            if (!IsRecipeInTab(recipe, _activeTab)) continue;

                            var isSelected = _selectedRecipe?.RecipeId == recipe.RecipeId;
                            var canProduce = CanProduce(recipe);
                            var isAuto = IsAutoProducing(recipe.RecipeId);

                            <div class="d-flex align-items-center justify-content-between p-2 rounded-3 border cursor-pointer select-none transition-all"
                                 style="height: 52px; border-color: @(isSelected ? "var(--bs-primary) !important" : "#e9ecef");
                                        background: @(isSelected ? "rgba(var(--bs-primary-rgb), 0.05)" : "#ffffff");
                                        box-shadow: @(isSelected ? "0 2px 8px rgba(var(--bs-primary-rgb), 0.12)" : "none");
                                        border-left: @(isSelected ? "4px solid var(--bs-primary) !important" : "1px solid #e9ecef");
                                        cursor: pointer;"
                                 @onclick="() => SelectRecipe(recipe)">
                                <div class="d-flex align-items-center gap-2 text-truncate" style="flex-grow: 1;">
                                    <span class="fs-4">@recipe.Emoji</span>
                                    <div class="text-truncate">
                                        <div class="fw-bold text-dark text-truncate" style="font-size: 0.82rem; line-height: 1.2;">@Loc.Entity(recipe.Name)</div>
                                        <div class="text-muted text-truncate" style="font-size: 0.65rem;">@recipe.Description</div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-1.5 ms-2">
                                    @if (isAuto)
                                    {
                                        <span class="badge bg-danger text-white rounded-pill d-flex align-items-center justify-content-center p-1" style="font-size: 0.6rem; height: 16px;" title="Auto">
                                            🤖
                                        </span>
                                    }
                                    <span class="rounded-circle d-inline-block" 
                                          style="width: 8px; height: 8px; background-color: @(canProduce ? "#28a745" : "#6c757d");"
                                          title="@(canProduce ? Loc["prod.produce_btn"] : Loc["prod.no_resources"])">
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Detail Recipe Workspace -->
            <div class="col-md-7 col-lg-8">
                @if (_selectedRecipe != null)
                {
                    var recipe = _selectedRecipe;
                    var canProduce = CanProduce(recipe);
                    var hasResources = HasResources(recipe);
                    var hasMoney = Player.Money >= recipe.ProductionCost * _productionQuantity;
                    var hasSpace = HasStorageSpace(recipe);

                    decimal inputCost, outputValue;
                    var profit = CalculateEstimatedProfit(recipe, out inputCost, out outputValue);
                    var profitPerUnit = profit;
                    var totalProfit = profit * _productionQuantity;
                    var roiPercent = inputCost + recipe.ProductionCost > 0 
                        ? (profit / (inputCost + recipe.ProductionCost)) * 100 
                        : 0;

                    <div class="card h-100 shadow-2xs border border-light-subtle rounded-3 overflow-hidden d-flex flex-column" 
                         style="background: #ffffff; height: 510px;">
                        
                        <!-- Premium Detail Header -->
                        <div class="py-2.5 px-3 border-bottom d-flex justify-content-between align-items-center" 
                             style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
                            <div class="d-flex align-items-center gap-2.5">
                                <span class="fs-2">@recipe.Emoji</span>
                                <div>
                                    <h5 class="mb-0 fw-bold text-dark" style="font-size: 1.05rem;">@Loc.Entity(recipe.Name)</h5>
                                    <p class="mb-0 text-muted small" style="font-size: 0.72rem; line-height: 1.2;">@recipe.Description</p>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="text-muted small fw-semibold text-uppercase" style="font-size: 0.6rem; letter-spacing: 0.5px;">@Loc["prod.requires"] (Fee)</div>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis fw-bold" style="font-size: 0.8rem; border: 1px solid rgba(108,117,125,0.15)">
                                    @recipe.ProductionCost.ToString("C")
                                </span>
                            </div>
                        </div>

                        <!-- Real-time Profitability Calculator Banner -->
                        <div class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center" 
                             style="background: @(profit > 0 ? "rgba(40, 167, 69, 0.05)" : "rgba(108, 117, 125, 0.03)"); min-height: 48px;">
                            <div class="d-flex align-items-center gap-1.5 small">
                                📊 <span class="fw-semibold text-muted">Est. Profit:</span>
                                @if (profit > 0)
                                {
                                    <span class="text-success fw-bold font-monospace" style="font-size: 0.85rem;">
                                        +@profitPerUnit.ToString("C") @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "за шт." : "/ unit")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted font-monospace" style="font-size: 0.85rem;">
                                        @profitPerUnit.ToString("C") @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "(операционные расходы)" : "(overhead cost)")
                                    </span>
                                }
                            </div>
                            <div class="text-end">
                                @if (profit > 0)
                                {
                                    <span class="badge bg-success text-white px-2.5 py-1 rounded-pill animate-pulse fw-bold" style="font-size: 0.72rem; letter-spacing: 0.2px;">
                                        🚀 Profit Margin: @roiPercent.ToString("F0")% ROI
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white px-2.5 py-1 rounded-pill fw-semibold" style="font-size: 0.72rem; opacity: 0.85;">
                                        Speculative
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Card Detail Body -->
                        <div class="card-body p-3 d-flex flex-column justify-content-between flex-grow-1 overflow-y-auto">
                            <!-- Visual flow row -->
                            <div class="row g-3 align-items-center justify-content-center mb-3">
                                <!-- Inputs Column -->
                                <div class="col-md-5">
                                    <div class="bg-light p-2.5 rounded-3 border border-light-subtle h-100">
                                        <div class="text-muted fw-bold mb-2 text-uppercase d-flex align-items-center gap-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                                            📥 @Loc["prod.requires"]
                                        </div>
                                        <div class="d-flex flex-column gap-1.5">
                                            @foreach (var input in recipe.Inputs)
                                            {
                                                var stock = GetInventoryQuantity(input.Key);
                                                var required = input.Value * _productionQuantity;
                                                var hasItem = stock >= required;
                                                <div class="d-flex justify-content-between align-items-center px-2 py-1 rounded transition-all @(hasItem ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")" 
                                                     style="font-size: 0.75rem; border: 1px solid @(hasItem ? "rgba(40,167,69,0.12)" : "rgba(220,53,69,0.12)");">
                                                    <span class="text-truncate fw-semibold" style="max-width: 90px;" title="@input.Key">@input.Key</span>
                                                    <span class="fw-bold font-monospace">@required (@stock)</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Animated Flow Arrow -->
                                <div class="col-md-2 text-center d-none d-md-block">
                                    <div class="d-flex flex-column align-items-center justify-content-center">
                                        <div class="fs-3 text-secondary animate-pulse">➡️</div>
                                        <span class="badge bg-light text-muted border px-1.5 py-0.5" style="font-size: 0.58rem; transform: translateY(-5px);">
                                            @recipe.ProductionTime @(recipe.ProductionTime == 1 ? "Tick" : "Ticks")
                                        </span>
                                    </div>
                                </div>

                                <!-- Outputs Column -->
                                <div class="col-md-5">
                                    <div class="bg-light p-2.5 rounded-3 border border-light-subtle h-100">
                                        <div class="text-muted fw-bold mb-2 text-uppercase d-flex align-items-center gap-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                                            📤 @Loc["prod.produces"]
                                        </div>
                                        <div class="d-flex flex-column gap-1.5">
                                            @foreach (var output in recipe.Outputs)
                                            {
                                                var efficiencyMultiplier = GetEfficiencyMultiplier(recipe);
                                                var outputQty = (int)(output.Value * efficiencyMultiplier * _productionQuantity);
                                                <div class="d-flex justify-content-between align-items-center px-2 py-1 rounded bg-primary-subtle text-primary border border-primary-subtle" 
                                                     style="font-size: 0.75rem;">
                                                    <span class="text-truncate fw-semibold" style="max-width: 90px;" title="@output.Key">@output.Key</span>
                                                    <span class="fw-bold font-monospace d-flex align-items-center gap-1">
                                                        @outputQty
                                                        @if (efficiencyMultiplier > 1)
                                                        {
                                                            <span class="text-success small" style="cursor: help;" title="@Loc["prod.factory_bonus"]">⭐</span>
                                                        }
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Bottom Row Controls & Action Panel -->
                            <div class="pt-3 border-top border-light-subtle mt-auto">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 animate-fade-in">
                                    <!-- Qty Adjuster Panel -->
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-muted fw-semibold" style="font-size: 0.75rem;">@Loc["prod.qty_label"]</span>
                                        <div class="input-group input-group-sm" style="width: 105px;">
                                            <button class="btn btn-outline-secondary px-2 fw-bold" type="button" 
                                                    style="border-radius: 4px 0 0 4px;"
                                                    @onclick="() => { if (_productionQuantity > 1) _productionQuantity--; }"
                                                    disabled="@(_productionQuantity <= 1)">-</button>
                                            <span class="form-control text-center fw-bold bg-white select-none d-flex align-items-center justify-content-center" 
                                                  style="font-size: 0.8rem; border-left: 0; border-right: 0; height: 28px; min-width: 35px; border-top: 1px solid #dee2e6; border-bottom: 1px solid #dee2e6;">
                                                @_productionQuantity
                                            </span>
                                            <button class="btn btn-outline-secondary px-2 fw-bold" type="button" 
                                                    style="border-radius: 0 4px 4px 0;"
                                                    @onclick="() => { if (_productionQuantity < 10) _productionQuantity++; }"
                                                    disabled="@(_productionQuantity >= 10)">+</button>
                                        </div>
                                        <span class="text-muted small italic" style="font-size: 0.65rem;">(Max 10)</span>
                                    </div>

                                    <!-- Profit Summary Info -->
                                    @if (profit > 0)
                                    {
                                        <div class="text-end small">
                                            <div class="text-muted fw-semibold" style="font-size: 0.65rem;">Est. Net Return</div>
                                            <span class="text-success fw-bold font-monospace" style="font-size: 0.85rem;">+@totalProfit.ToString("C")</span>
                                        </div>
                                    }

                                    <!-- Automation Toggle Switch -->
                                    <div class="form-check form-switch m-0 p-0 d-flex align-items-center gap-2" style="min-height: auto;">
                                        <input class="form-check-input ms-0 cursor-pointer" type="checkbox" id="detail-auto-@recipe.RecipeId"
                                               checked="@IsAutoProducing(recipe.RecipeId)"
                                               @onchange="(e) => ToggleAutoProduction(recipe.RecipeId, e.Value)" 
                                               style="height: 14px; width: 28px; cursor: pointer; float: none; margin-top: 0;" />
                                        <label class="form-check-label text-muted fw-bold select-none cursor-pointer" for="detail-auto-@recipe.RecipeId" 
                                               style="font-size: 0.72rem;">@Loc["prod.auto_label"]</label>
                                    </div>
                                </div>

                                @if (IsAutoProducing(recipe.RecipeId))
                                {
                                    <!-- Glassmorphic Auto-Production Settings Block -->
                                    <div class="mt-2.5 p-2.5 rounded-3 border animate-fade-in bg-light-subtle" 
                                         style="background: rgba(248, 249, 250, 0.7); backdrop-filter: blur(8px); border-color: rgba(222, 226, 230, 0.8); box-shadow: inset 0 1px 3px rgba(0,0,0,0.02);">
                                        <div class="d-flex align-items-center gap-1.5 mb-2 border-bottom pb-1" style="border-bottom-style: dashed !important;">
                                            <span style="font-size: 0.8rem;">⚙️</span>
                                            <span class="fw-bold text-dark text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.5px;">@Loc["prod.auto_settings"]</span>
                                        </div>

                                        <div class="d-flex flex-column gap-2.5">
                                            <!-- MIN Reserve Control -->
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="fw-semibold text-secondary" style="font-size: 0.72rem;" title="@Loc["prod.min_reserve_desc"]">
                                                        📦 @Loc["prod.min_reserve"]
                                                    </span>
                                                    <span class="badge bg-secondary text-white font-monospace fw-bold" style="font-size: 0.75rem;">
                                                        @GetMinReserve(recipe.RecipeId)
                                                    </span>
                                                </div>
                                                <div class="d-flex align-items-center gap-2 mt-1">
                                                    <button class="btn btn-xs btn-outline-secondary px-1.5 py-0.5 font-monospace fw-semibold" style="font-size: 0.65rem; white-space: nowrap;"
                                                            @onclick="() => SetMinReserve(recipe.RecipeId, GetMinReserve(recipe.RecipeId) - 100)">-100</button>
                                                    <button class="btn btn-xs btn-outline-secondary px-1.5 py-0.5 font-monospace fw-semibold" style="font-size: 0.65rem; white-space: nowrap;"
                                                            @onclick="() => SetMinReserve(recipe.RecipeId, GetMinReserve(recipe.RecipeId) - 10)">-10</button>
                                                    
                                                    <input type="range" class="form-range flex-grow-1 cursor-pointer accent-secondary" style="height: 4px;"
                                                           min="0" max="2000" step="10"
                                                           value="@GetMinReserve(recipe.RecipeId)"
                                                           @onchange='(e) => SetMinReserve(recipe.RecipeId, Convert.ToInt32(e.Value))' />

                                                    <button class="btn btn-xs btn-outline-secondary px-1.5 py-0.5 font-monospace fw-semibold" style="font-size: 0.65rem; white-space: nowrap;"
                                                            @onclick="() => SetMinReserve(recipe.RecipeId, GetMinReserve(recipe.RecipeId) + 10)">+10</button>
                                                    <button class="btn btn-xs btn-outline-secondary px-1.5 py-0.5 font-monospace fw-semibold" style="font-size: 0.65rem; white-space: nowrap;"
                                                            @onclick="() => SetMinReserve(recipe.RecipeId, GetMinReserve(recipe.RecipeId) + 100)">+100</button>
                                                </div>
                                            </div>

                                            <!-- MAX Stock Control -->
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="fw-semibold text-secondary" style="font-size: 0.72rem;" title="@Loc["prod.max_stock_desc"]">
                                                        🏭 @Loc["prod.max_stock"]
                                                    </span>
                                                    <span class="badge bg-primary text-white font-monospace fw-bold" style="font-size: 0.75rem;">
                                                        @GetMaxStock(recipe.RecipeId)
                                                    </span>
                                                </div>
                                                <div class="d-flex align-items-center gap-2 mt-1">
                                                    <button class="btn btn-xs btn-outline-secondary px-1.5 py-0.5 font-monospace fw-semibold" style="font-size: 0.65rem; white-space: nowrap;"
                                                            @onclick="() => SetMaxStock(recipe.RecipeId, GetMaxStock(recipe.RecipeId) - 1000)">-1k</button>
                                                    <button class="btn btn-xs btn-outline-secondary px-1.5 py-0.5 font-monospace fw-semibold" style="font-size: 0.65rem; white-space: nowrap;"
                                                            @onclick="() => SetMaxStock(recipe.RecipeId, GetMaxStock(recipe.RecipeId) - 100)">-100</button>
                                                    
                                                    <input type="range" class="form-range flex-grow-1 cursor-pointer accent-primary" style="height: 4px;"
                                                           min="5" max="@Player.TotalCargoCapacity" step="25"
                                                           value="@GetMaxStock(recipe.RecipeId)"
                                                           @onchange='(e) => SetMaxStock(recipe.RecipeId, Convert.ToInt32(e.Value))' />

                                                    <button class="btn btn-xs btn-outline-secondary px-1.5 py-0.5 font-monospace fw-semibold" style="font-size: 0.65rem; white-space: nowrap;"
                                                            @onclick="() => SetMaxStock(recipe.RecipeId, GetMaxStock(recipe.RecipeId) + 100)">+100</button>
                                                    <button class="btn btn-xs btn-outline-secondary px-1.5 py-0.5 font-monospace fw-semibold" style="font-size: 0.65rem; white-space: nowrap;"
                                                            @onclick="() => SetMaxStock(recipe.RecipeId, GetMaxStock(recipe.RecipeId) + 1000)">+1k</button>
                                                </div>
                                            </div>

                                            <!-- Speed Upgrades Control -->
                                            <div class="border-top pt-2" style="border-top-style: dashed !important; border-top-color: rgba(0,0,0,0.1) !important;">
                                                <div class="d-flex justify-content-between align-items-center mb-1.5">
                                                    <span class="fw-semibold text-secondary" style="font-size: 0.72rem;">
                                                        ⚡ @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "Линия производства" : "Production Line Upgrade")
                                                    </span>
                                                    <span class="badge bg-warning text-dark font-monospace fw-bold" style="font-size: 0.75rem;">
                                                        Lvl @GetAutoProductionLevel(recipe.RecipeId)/4 (@GetLevelThroughput(GetAutoProductionLevel(recipe.RecipeId)))
                                                    </span>
                                                </div>
                                                
                                                <div class="p-2 rounded bg-white border border-light-subtle shadow-2xs d-flex align-items-center justify-content-between">
                                                    <div class="d-flex flex-column">
                                                        <span class="fw-bold text-dark" style="font-size: 0.75rem;">
                                                            @GetLevelName(GetAutoProductionLevel(recipe.RecipeId))
                                                        </span>
                                                        <span class="text-muted small" style="font-size: 0.65rem;">
                                                            @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "Скорость выпуска" : "Output speed"): 
                                                            <strong class="text-primary">@GetLevelThroughput(GetAutoProductionLevel(recipe.RecipeId))</strong>
                                                        </span>
                                                    </div>
                                                    
                                                    @if (GetAutoProductionLevel(recipe.RecipeId) < 4)
                                                    {
                                                        var nextLvl = GetAutoProductionLevel(recipe.RecipeId) + 1;
                                                        var upgradeCost = GetUpgradeCost(nextLvl);
                                                        var canAfford = Player.Money >= upgradeCost;
                                                        
                                                        <button class="btn btn-xs fw-bold px-2 py-1 transition-all @(canAfford ? "btn-warning text-dark" : "btn-outline-secondary")"
                                                                style="font-size: 0.68rem; border-radius: 4px;"
                                                                @onclick="() => UpgradeSpeed(recipe.RecipeId)"
                                                                disabled="@(!canAfford)">
                                                            🔼 @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "Улучшить за" : "Upgrade for") @upgradeCost.ToString("C0")
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-success small fw-bold" style="font-size: 0.68rem;">
                                                            👑 @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "Максимум" : "Maxed Out")
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Action Button Panel -->
                                <div class="mt-3">
                                    <button class="btn w-100 py-1.5 fw-bold d-flex align-items-center justify-content-center gap-2 transition-all shadow-sm @(canProduce ? "btn-success" : "btn-outline-secondary")"
                                            style="height: 38px; font-size: 0.88rem; border-radius: 6px;"
                                            @onclick="() => Produce(recipe)" disabled="@(!canProduce)">
                                        @if (canProduce)
                                        {
                                            <span class="animate-pulse">⚡ @Loc["prod.produce_btn"] (@_productionQuantity @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "шт." : "units"))</span>
                                        }
                                        else if (Player.IsSabotaged)
                                        {
                                            <span class="text-danger">❌ @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "Работа заблокирована (Саботаж)" : "Operations blocked (Sabotage)")</span>
                                        }
                                        else if (!hasResources)
                                        {
                                            <span class="text-danger">❌ @Loc["prod.no_resources"]</span>
                                        }
                                        else if (!hasMoney)
                                        {
                                            <span class="text-danger">💸 @Loc["prod.no_money"]</span>
                                        }
                                        else if (!hasSpace)
                                        {
                                            <span class="text-danger">📦 @Loc["prod.no_space"]</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card h-100 shadow-2xs border border-light-subtle rounded-3 p-4 d-flex align-items-center justify-content-center text-muted" 
                         style="background: #ffffff; height: 510px;">
                        <div>
                            📭 @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "Нет рецептов в этой категории" : "No recipes available in this category")
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Player? Player { get; set; }

    private string _activeTab = "all";
    private ProductionRecipe? _selectedRecipe;
    private string _message = "";
    private string _messageClass = "alert-info";
    private int _productionQuantity = 1;

    protected override void OnInitialized()
    {
        Loc.OnLanguageChanged += Refresh;
        // Select the first recipe as default
        if (ProductionRecipes.AllRecipes.Any())
        {
            _selectedRecipe = ProductionRecipes.AllRecipes.First();
        }
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Loc.OnLanguageChanged -= Refresh;
    }

    private int GetInventoryQuantity(string itemName)
    {
        return Player?.Inventory.FirstOrDefault(i => i.ItemName == itemName)?.Quantity ?? 0;
    }

    private decimal GetMarketPrice(string itemName)
    {
        var item = GameEngine.ExchangeItems.FirstOrDefault(i => i.Name == itemName);
        return item?.CurrentPrice ?? 0m;
    }

    private decimal CalculateEstimatedProfit(ProductionRecipe recipe, out decimal inputCost, out decimal outputValue)
    {
        inputCost = recipe.Inputs.Sum(i => GetMarketPrice(i.Key) * i.Value);
        var efficiencyMultiplier = GetEfficiencyMultiplier(recipe);
        outputValue = recipe.Outputs.Sum(o => GetMarketPrice(o.Key) * o.Value * efficiencyMultiplier);
        return outputValue - inputCost - recipe.ProductionCost;
    }

    private bool IsRecipeInTab(ProductionRecipe recipe, string tab)
    {
        if (tab == "all") return true;
        if (tab == "auto") return IsAutoProducing(recipe.RecipeId);

        var name = recipe.Name;
        if (tab == "food")
        {
            return name == "Хлеб" || name == "Биотопливо" || name == "Сахар" || name == "Кофе";
        }
        if (tab == "industry")
        {
            return name == "Оборудование" || name == "Химикаты" || name == "Текстиль";
        }
        if (tab == "luxury")
        {
            return name == "Электроника" || name == "Фармацевтика" || name == "Люкс-товары";
        }
        return false;
    }

    private void SetActiveTab(string tab)
    {
        _activeTab = tab;
        // Auto-select first recipe in the new tab to keep the detail view populated
        var firstInTab = ProductionRecipes.AllRecipes.FirstOrDefault(r => IsRecipeInTab(r, _activeTab));
        if (firstInTab != null)
        {
            _selectedRecipe = firstInTab;
            _productionQuantity = 1;
        }
        else
        {
            _selectedRecipe = null;
        }
        _message = "";
    }

    private void SelectRecipe(ProductionRecipe recipe)
    {
        _selectedRecipe = recipe;
        _productionQuantity = 1;
        _message = "";
    }

    private bool HasResources(ProductionRecipe recipe)
    {
        foreach (var input in recipe.Inputs)
        {
            if (GetInventoryQuantity(input.Key) < input.Value * _productionQuantity)
                return false;
        }
        return true;
    }

    private bool HasStorageSpace(ProductionRecipe recipe)
    {
        var outputTotal = recipe.Outputs.Sum(o => o.Value) * _productionQuantity;
        var inputTotal = recipe.Inputs.Sum(i => i.Value) * _productionQuantity;
        var netChange = outputTotal - inputTotal;
        return Player!.AvailableCargoSpace >= netChange;
    }

    private bool CanProduce(ProductionRecipe recipe)
    {
        if (Player == null || Player.IsSabotaged) return false;
        return HasResources(recipe) &&
               Player.Money >= recipe.ProductionCost * _productionQuantity &&
               HasStorageSpace(recipe);
    }

    private void Produce(ProductionRecipe recipe)
    {
        if (Player == null || !CanProduce(recipe)) return;

        // Deduct production cost
        var totalCost = recipe.ProductionCost * _productionQuantity;
        Player.Money -= totalCost;

        // Remove input materials
        foreach (var input in recipe.Inputs)
        {
            var requiredQty = input.Value * _productionQuantity;
            var invItem = Player.Inventory.FirstOrDefault(i => i.ItemName == input.Key);
            if (invItem != null)
            {
                invItem.Quantity -= requiredQty;
                if (invItem.Quantity <= 0)
                {
                    Player.Inventory.Remove(invItem);
                }
            }
        }

        // Add output products
        var efficiencyMultiplier = GetEfficiencyMultiplier(recipe);
        foreach (var output in recipe.Outputs)
        {
            var outputQty = (int)(output.Value * efficiencyMultiplier * _productionQuantity);
            var existingItem = Player.Inventory.FirstOrDefault(i => i.ItemName == output.Key);

            if (existingItem != null)
            {
                existingItem.Quantity += outputQty;
            }
            else
            {
                // Get market price if available, otherwise estimate
                var marketItem = GameEngine.ExchangeItems.FirstOrDefault(i => i.Name == output.Key);
                var price = marketItem?.CurrentPrice ?? 100m;

                Player.Inventory.Add(new InventoryItem
                {
                    ItemName = output.Key,
                    Quantity = outputQty,
                    PurchasePrice = price,
                    AveragePrice = price
                });
            }
        }

        var outputNames = string.Join(", ", recipe.Outputs.Select(o => $"{o.Key} x{o.Value * _productionQuantity}"));
        _message = string.Format(Loc["prod.produced"], outputNames, totalCost.ToString("C"));
        _messageClass = "alert-success";

        StateHasChanged();
    }

    private bool IsAutoProducing(Guid recipeId)
    {
        return Player?.AutoProductionRecipes?.Contains(recipeId) ?? false;
    }

    private void ToggleAutoProduction(Guid recipeId, object? value)
    {
        if (Player == null) return;

        bool isChecked = (bool)(value ?? false);

        if (isChecked)
        {
            if (!Player.AutoProductionRecipes.Contains(recipeId))
                Player.AutoProductionRecipes.Add(recipeId);
        }
        else
        {
            Player.AutoProductionRecipes.Remove(recipeId);
        }

        StateHasChanged();
    }

    private decimal GetEfficiencyMultiplier(ProductionRecipe recipe)
    {
        if (Player == null) return 1.0m;

        var matchingFactory = Player.Factories.FirstOrDefault(f =>
            EconomicGame.Services.GameEngine.AvailableFactories.Any(af => af.Type == f.Type && af.TargetRecipe == recipe.Name));

        return matchingFactory?.IsOperational == true ? matchingFactory.EfficiencyMultiplier : 1.0m;
    }

    private int GetMinReserve(Guid recipeId)
    {
        if (Player == null) return 0;
        if (Player.AutoProductionMinReserves == null) Player.AutoProductionMinReserves = new();
        return Player.AutoProductionMinReserves.TryGetValue(recipeId, out var val) ? val : 0;
    }

    private void SetMinReserve(Guid recipeId, int val)
    {
        if (Player == null) return;
        if (Player.AutoProductionMinReserves == null) Player.AutoProductionMinReserves = new();
        Player.AutoProductionMinReserves[recipeId] = Math.Max(0, val);
    }

    private int GetMaxStock(Guid recipeId)
    {
        if (Player == null) return 500;
        if (Player.AutoProductionMaxStock == null) Player.AutoProductionMaxStock = new();
        return Player.AutoProductionMaxStock.TryGetValue(recipeId, out var val) ? val : 500;
    }

    private void SetMaxStock(Guid recipeId, int val)
    {
        if (Player == null) return;
        if (Player.AutoProductionMaxStock == null) Player.AutoProductionMaxStock = new();
        Player.AutoProductionMaxStock[recipeId] = Math.Max(1, val);
    }

    private int GetAutoProductionLevel(Guid recipeId) => Player?.AutoProductionLevels?.TryGetValue(recipeId, out var val) == true ? val : 1;

    private string GetLevelName(int lvl) => lvl switch
    {
        1 => Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "Ручная сборка" : "Manual Assembly",
        2 => Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "Высокоскоростной конвейер" : "High-Speed Conveyor",
        3 => Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "Автоматическая линия" : "Automated Production Line",
        4 => Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "Роботизированный комплекс" : "Robotic Mega-Complex",
        _ => "Unknown"
    };

    private string GetLevelThroughput(int lvl) => lvl switch
    {
        1 => "1x",
        2 => "2x",
        3 => "3x",
        4 => "5x",
        _ => "1x"
    };

    private decimal GetUpgradeCost(int lvl) => lvl switch
    {
        2 => 50000m,
        3 => 200000m,
        4 => 1000000m,
        _ => 0m
    };

    private void UpgradeSpeed(Guid recipeId)
    {
        if (Player == null) return;
        var res = GameEngine.UpgradeAutoProductionSpeed(Player, recipeId);
        _message = res;
        _messageClass = res.Contains("Успешно") || res.Contains("Success") || res.Contains("улучшено") ? "alert-success" : "alert-danger";
        StateHasChanged();
    }
}

