@page "/market"
@inject EconomicGame.Services.GameEngine GameEngine
@inject LocalizationService Loc
@inject EconomicGame.Services.NavigationStateService NavState

<div class="market-dashboard">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 text-dark fw-bold">@Loc["dashboard.title"]</h2>
        <span class="badge bg-secondary p-2" style="font-size: 0.9rem;">
            💼 @Player?.Name
        </span>
    </div>
    
    @if (Player == null)
    {
        <div class="alert alert-warning shadow-sm">
            <h5 class="alert-heading">@Loc["stock.create_character"]</h5>
            <p class="mb-0">Please create a player first to access the business panel!</p>
        </div>
    }
    else
    {
        <!-- Summary Cards Grid -->
        <div class="row g-3 mb-4">
            <!-- Net Worth Card -->
            <div class="col-md-3">
                <div class="card border-0 h-100 shadow-sm text-white position-relative overflow-hidden hover-scale" 
                     style="background: linear-gradient(135deg, #4361ee 0%, #3f37c9 100%); border-radius: 14px; transition: transform 0.2s ease;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <small class="text-white-50 text-uppercase fw-bold" style="font-size: 0.75rem;">@Loc["dashboard.net_worth"]</small>
                                <h3 class="my-1 fw-extrabold text-white" style="font-size: 1.6rem; letter-spacing: -0.5px;">
                                    @Player.ComputeMarketNetWorth(ExchangeItems).ToString("C")
                                </h3>
                            </div>
                            <span class="fs-2 text-white-50 opacity-75">💎</span>
                        </div>
                        <p class="card-text small text-white-50 mb-0 mt-2" style="font-size: 0.7rem; line-height: 1.2;">
                            @Loc["dashboard.net_worth_desc"]
                        </p>
                    </div>
                </div>
            </div>

            <!-- Reputation & Status Card -->
            <div class="col-md-3">
                <div class="card border-0 h-100 shadow-sm text-white position-relative overflow-hidden hover-scale" 
                     style="background: linear-gradient(135deg, #f72585 0%, #b5179e 100%); border-radius: 14px; transition: transform 0.2s ease;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <small class="text-white-50 text-uppercase fw-bold" style="font-size: 0.75rem;">@Loc["dashboard.reputation"]</small>
                                <h3 class="my-1 fw-extrabold text-white" style="font-size: 1.4rem; letter-spacing: -0.5px;">
                                    @Player.Reputation @(GetReputationTitle(Player.Reputation))
                                </h3>
                            </div>
                            <span class="fs-2 text-white-50 opacity-75">👑</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-1 text-white-50 small" style="font-size: 0.75rem;">
                            <span>@Loc["dashboard.license_level"]:</span>
                            <strong class="text-white">Lv. @Player.TradingLicenseLevel</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Logistics Utilization Card -->
            <div class="col-md-3">
                <div class="card border-0 h-100 shadow-sm text-white position-relative overflow-hidden hover-scale" 
                     style="background: linear-gradient(135deg, #4cc9f0 0%, #4895ef 100%); border-radius: 14px; transition: transform 0.2s ease;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <small class="text-white-50 text-uppercase fw-bold" style="font-size: 0.75rem;">@Loc["dashboard.cargo_logistics"]</small>
                                <h3 class="my-1 fw-extrabold text-white" style="font-size: 1.6rem; letter-spacing: -0.5px;">
                                    @Player.CurrentCargoUsed / @Player.TotalCargoCapacity <span style="font-size: 0.8rem; font-weight: normal;">@Loc["inv.units"]</span>
                                </h3>
                            </div>
                            <span class="fs-2 text-white-50 opacity-75">🚛</span>
                        </div>
                        @{
                            var pct = Player.TotalCargoCapacity > 0 ? (Player.CurrentCargoUsed * 100 / Player.TotalCargoCapacity) : 0;
                            var pctColor = pct > 90 ? "bg-danger" : (pct > 70 ? "bg-warning" : "bg-white");
                        }
                        <div class="mt-3">
                            <div class="progress" style="height: 6px; background-color: rgba(255,255,255,0.25); border-radius: 10px;">
                                <div class="progress-bar @pctColor" role="progressbar" style="width: @pct%" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <div class="d-flex justify-content-between text-white-50 small mt-1" style="font-size: 0.7rem;">
                                <span>@Loc["dashboard.cargo_capacity"]:</span>
                                <strong class="text-white">@pct%</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Trading Success Stats Card -->
            <div class="col-md-3">
                <div class="card border-0 h-100 shadow-sm text-white position-relative overflow-hidden hover-scale" 
                     style="background: linear-gradient(135deg, #06d6a0 0%, #11998e 100%); border-radius: 14px; transition: transform 0.2s ease;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <small class="text-white-50 text-uppercase fw-bold" style="font-size: 0.75rem;">@Loc["dashboard.trading_perf"]</small>
                                <h3 class="my-1 fw-extrabold text-white" style="font-size: 1.6rem; letter-spacing: -0.5px;">
                                    @((Player.SuccessScore * 100).ToString("F0"))%
                                </h3>
                            </div>
                            <span class="fs-2 text-white-50 opacity-75">📈</span>
                        </div>
                        <p class="card-text small text-white-50 mb-0 mt-3 pt-1" style="font-size: 0.75rem;">
                            @string.Format(Loc["dashboard.trades_profitable"], Player.ProfitableTrades, Player.TotalTrades)
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Asset Breakdown Section -->
            <div class="col-md-7">
                <div class="card border-0 shadow-sm" style="border-radius: 12px;">
                    <div class="card-header bg-dark text-white py-3 px-4 d-flex justify-content-between align-items-center" style="border-top-left-radius: 12px; border-top-right-radius: 12px;">
                        <h5 class="mb-0 text-white"><span class="me-2">📊</span>@Loc["dashboard.assets_breakdown"]</h5>
                    </div>
                    <div class="card-body p-4" style="background-color: #fcfcfc;">
                        <div class="row g-3">
                            <!-- Liquid Assets column -->
                            <div class="col-md-6">
                                <h6 class="text-muted text-uppercase mb-3 fw-bold" style="font-size: 0.8rem; letter-spacing: 0.5px;">
                                    💰 @Loc["dashboard.liquid_capital"]
                                </h6>
                                <div class="p-3 bg-light rounded border border-light shadow-2xs mb-2 d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="small text-muted mb-0" style="font-size: 0.75rem;">@Loc["dashboard.cash_balance"]</div>
                                        <strong class="text-success fs-5">@Player.Money.ToString("C")</strong>
                                    </div>
                                    <span class="fs-3 text-success-50 opacity-50">💵</span>
                                </div>
                                <div class="p-3 bg-light rounded border border-light shadow-2xs d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="small text-muted mb-0" style="font-size: 0.75rem;">@Loc["dashboard.bank_savings"]</div>
                                        <strong class="text-primary fs-5">@Player.BankDeposit.ToString("C")</strong>
                                    </div>
                                    <span class="fs-3 text-primary-50 opacity-50">🏦</span>
                                </div>
                            </div>

                            <!-- Industrial/Real Estate column -->
                            <div class="col-md-6">
                                <h6 class="text-muted text-uppercase mb-3 fw-bold" style="font-size: 0.8rem; letter-spacing: 0.5px;">
                                    🏢 @Loc["dashboard.property_industry"]
                                </h6>
                                <ul class="list-group list-group-flush shadow-2xs rounded border">
                                    <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                                        <span class="small text-muted">🏭 @Loc["dashboard.factories_owned"]</span>
                                        <span class="badge bg-secondary">@Player.Factories.Count</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                                        <span class="small text-muted">📦 @Loc["dashboard.warehouses_owned"]</span>
                                        <span class="badge bg-secondary">@Player.Warehouses.Count</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                                        <span class="small text-muted">🏠 @Loc["dashboard.residential_prop"]</span>
                                        <span class="small fw-semibold text-truncate ms-2" style="max-width: 120px;">
                                            @if (Player.Properties == null || !Player.Properties.Any())
                                            {
                                                @Loc["dashboard.no_housing"]
                                            }
                                            else if (Player.Properties.Count == 1)
                                            {
                                                @Loc.Entity(Player.Properties[0].Name)
                                            }
                                            else
                                            {
                                                <span>@Player.Properties.Count @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "объекта" : "properties")</span>
                                            }
                                        </span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                                        <span class="small text-muted">🏞️ @Loc["dashboard.land_plots"]</span>
                                        <span class="small fw-semibold text-truncate ms-2" style="max-width: 120px;">
                                            @if (!Player.Lands.Any())
                                            {
                                                @Loc["dashboard.no_land"]
                                            }
                                            else if (Player.Lands.Count == 1)
                                            {
                                                @Loc.Entity(Player.Lands[0].Name)
                                            }
                                            else
                                            {
                                                <span>@Player.Lands.Count @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "участка" : "plots")</span>
                                            }
                                        </span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Vehicles & Logistics Section -->
            <div class="col-md-5">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                    <div class="card-header bg-dark text-white py-3 px-4 d-flex justify-content-between align-items-center" style="border-top-left-radius: 12px; border-top-right-radius: 12px;">
                        <h5 class="mb-0 text-white"><span class="me-2">🚛</span>@Loc["dashboard.vehicles_logistics"]</h5>
                    </div>
                    <div class="card-body p-4 d-flex flex-column justify-content-center" style="background-color: #fcfcfc;">
                        @if (Player.Vehicles == null || !Player.Vehicles.Any())
                        {
                            <div class="text-center py-3">
                                <div class="fs-1 mb-2">🚗</div>
                                <h6 class="fw-bold mb-1">@Loc["dashboard.no_vehicle"]</h6>
                                <p class="text-muted small px-3 mb-4">
                                    @Loc["dashboard.need_vehicle"]
                                </p>
                                <button class="btn btn-primary btn-sm px-4 py-2 shadow-sm rounded-pill fw-bold" @onclick="BuyCar">
                                    ⚡ @Loc["dashboard.buy_basic_car"] ($2,000)
                                </button>
                            </div>
                        }
                        else
                        {
                            var primaryVehicle = Player.Vehicles.OrderByDescending(v => v.CargoCapacity).First();
                            var operationalCount = Player.Vehicles.Count(v => v.IsOperational);
                            var totalCapacity = Player.Vehicles.Sum(v => v.CargoCapacity);
                            
                            <div class="text-center py-2">
                                <div class="display-5 mb-2">@primaryVehicle.Emoji</div>
                                @if (Player.Vehicles.Count == 1)
                                {
                                    <h5 class="fw-bold mb-1">@Loc.Entity(primaryVehicle.Name)</h5>
                                }
                                else
                                {
                                    <h5 class="fw-bold mb-1">
                                        @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "Ваш Флот" : "Your Fleet") (@Player.Vehicles.Count)
                                    </h5>
                                }
                                
                                <div class="d-flex justify-content-center flex-wrap gap-2 mb-3">
                                    <span class="badge bg-dark-subtle text-dark border border-secondary-subtle px-2 py-1">
                                        @Loc["inv.capacity"]: @totalCapacity @Loc["inv.units"]
                                    </span>
                                    @if (operationalCount == Player.Vehicles.Count)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            🟢 @Loc["dashboard.operational"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                            ⚠️ @operationalCount/@Player.Vehicles.Count @(Loc.CurrentLanguage == EconomicGame.Services.Language.Ru ? "исправны" : "operational")
                                        </span>
                                    }
                                </div>
                                
                                @if (Player.Vehicles.Count > 1)
                                {
                                    <div class="text-start bg-light p-2 rounded mb-3 border border-light" style="max-height: 100px; overflow-y: auto; font-size: 0.8rem;">
                                        @foreach (var vehicle in Player.Vehicles)
                                        {
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span>@vehicle.Emoji @Loc.Entity(vehicle.Name)</span>
                                                <span class="text-muted small">@vehicle.CargoCapacity @Loc["inv.units"]</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted small px-3 mb-4">
                                        Your operational vehicle guarantees reliable cargo deliveries and full trading license privileges across cities.
                                    </p>
                                }
                                
                                <button class="btn btn-outline-primary btn-sm px-4 rounded-pill fw-bold" @onclick="GoToLogistics">
                                    🚚 @Loc["dashboard.manage_logistics"]
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public EconomicGame.Player? Player { get; set; }

    [Parameter]
    public List<EconomicGame.MarketItem> ExchangeItems { get; set; } = new();

    private void BuyCar()
    {
        if (Player == null) return;
        GameEngine.BuyCar(Player);
    }

    private void GoToLogistics()
    {
        NavState.CurrentView = "Logistics";
    }

    private string GetReputationTitle(int rep)
    {
        if (rep >= 80) return $"({Loc["dashboard.rep_magnate"]})";
        if (rep >= 50) return $"({Loc["dashboard.rep_partner"]})";
        if (rep >= 30) return $"({Loc["dashboard.rep_associate"]})";
        return $"({Loc["dashboard.rep_novice"]})";
    }
}