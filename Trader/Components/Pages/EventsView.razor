@using EconomicGame
@inject EconomicGame.Services.GameEngine GameEngine
@inject LocalizationService Loc
@implements IDisposable

<div class="events">
    <h2>@Loc["events.title"]</h2>

    @if (Player == null)
    {
        <p>@Loc["events.create_character"]</p>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="card bg-light">
                    <div class="card-body">
                        <h5>@Loc["events.profile"]</h5>
                        <p><strong>@Loc["events.name"]:</strong> @Player.Name</p>
                        <p><strong>@Loc["events.money"]:</strong> @Player.Money.ToString("C")</p>
                        <p><strong>@Loc["events.reputation"]:</strong>
                            <span class="badge @GetReputationBadgeClass()">
                                @Player.Reputation / 100
                            </span>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        @if (!GetActiveEvents().Any())
        {
            <div class="alert alert-info">
                <h5>@Loc["events.none"]</h5>
                <p>@Loc["events.none_desc"]</p>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var gameEvent in GetActiveEvents())
                {
                    <div class="col-md-6 mb-3">
                        <div class="card @GetEventCardClass(gameEvent)">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">@Loc.T(gameEvent.Title)</h5>
                                <span class="badge bg-secondary">
                                    ⏰ @GetTimeRemaining(gameEvent)
                                </span>
                            </div>
                            <div class="card-body">
                                <p class="card-text">@Loc.T(gameEvent.Description)</p>

                                <hr />

                                <div class="d-grid gap-2">
                                    @foreach (var choice in gameEvent.Choices)
                                    {
                                        var canAfford = !choice.Cost.HasValue || Player.Money >= choice.Cost.Value;
                                        <button class="btn @(canAfford ? "btn-primary" : "btn-secondary")"
                                                disabled="@(!canAfford)"
                                                @onclick="() => MakeChoice(gameEvent, choice)">
                                            @Loc.T(choice.Text)
                                            @if (!canAfford && choice.Cost.HasValue)
                                            {
                                                <span class="text-warning">@Loc["events.insufficient"]</span>
                                            }
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @_messageClass mt-3">
                <strong>@Loc["events.result"]</strong> @Loc.T(_message)
            </div>
        }

        <hr />

        <div class="mt-4">
            <h4>@Loc["events.history"]</h4>
            @{
                var completedEvents = Player.PendingEvents.Where(e => e.IsExpired).OrderByDescending(e => e.ExpiresAt).Take(5).ToList();
            }
            @if (completedEvents.Any())
            {
                <ul class="list-group">
                    @foreach (var evt in completedEvents)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@Loc.T(evt.Title)</strong>
                                <br />
                                <small class="text-muted">@(string.IsNullOrEmpty(evt.OutcomeMessage) ? "" : Loc.T(evt.OutcomeMessage))</small>
                            </div>
                            <span class="badge bg-secondary">@Loc["events.completed"]</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">@Loc["events.history_empty"]</p>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public Player? Player { get; set; }

    private string _message = "";
    private string _messageClass = "alert-info";

    protected override void OnInitialized()
    {
        Loc.OnLanguageChanged += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Loc.OnLanguageChanged -= Refresh;
    }

    private List<GameEvent> GetActiveEvents()
    {
        return Player?.PendingEvents.Where(e => !e.IsExpired).ToList() ?? new List<GameEvent>();
    }

    private string GetTimeRemaining(GameEvent evt)
    {
        var remaining = evt.ExpiresAt - GameEngine.CurrentTime;
        if (remaining.TotalMinutes < 0) return Loc["events.expired"];
        if (remaining.TotalHours >= 1) return $"{(int)remaining.TotalHours}{Loc["events.hours_short"]} {remaining.Minutes}{Loc["events.minutes_short"]}";
        return $"{remaining.Minutes}{Loc["events.minutes_short"]}";
    }

    private string GetEventCardClass(GameEvent evt)
    {
        var remaining = evt.ExpiresAt - GameEngine.CurrentTime;
        if (remaining.TotalMinutes < 15) return "border-danger";
        if (remaining.TotalMinutes < 30) return "border-warning";
        return "border-primary";
    }

    private string GetReputationBadgeClass()
    {
        if (Player == null) return "bg-secondary";
        if (Player.Reputation >= 80) return "bg-success";
        if (Player.Reputation >= 50) return "bg-primary";
        if (Player.Reputation >= 30) return "bg-warning";
        return "bg-danger";
    }

    private void MakeChoice(GameEvent gameEvent, EventChoice choice)
    {
        if (Player == null) return;

        var result = GameEngine.RespondToEvent(Player, gameEvent.EventId, choice.ChoiceId);
        _message = result;
        // Service returns Russian for outcome messages; detect negative outcome by Russian stems
        _messageClass = result.Contains("ухудш") || result.Contains("развод") ? "alert-warning" : "alert-success";
        StateHasChanged();
    }
}
