    private async Task PlayDiceEnhanced(string betType)
    {
        if (Player == null || _isPlaying) return;

        _isPlaying = true;
        ClearGameState();
        StateHasChanged();

        // Animate dice rolling
        for (int i = 0; i < 8; i++)
        {
