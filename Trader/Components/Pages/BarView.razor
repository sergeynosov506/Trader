        else _totalProfit -= _betAmount;
        
        _isPlaying = false;
        StateHasChanged();
    }

    // Interactive Yahtzee Dice Methods
    private async Task StartDiceGame()
    {
        if (Player == null || _isPlaying || _diceGameActive) return;

        if (_betAmount > Player.Money)
        {
            _lastGameResult = "💸 Недостаточно денег для ставки!";
            _lastWin = false;
            StateHasChanged();
            return;
        }

        _diceGameActive = true;
        _diceCurrentBet = _betAmount;
        _diceRollsLeft = 3;
        _diceHeld = new bool[5];
        _selectedCombination = null;
        ClearGameState();

        await RollDice();
    }

    private async Task RollDice()
    {
        if (!_diceGameActive || _diceRollsLeft <= 0 || _isPlaying) return;

        _isPlaying = true;
        StateHasChanged();

        // Animate rolling dice
        for (int anim = 0; anim < 8; anim++)
        {
            for (int i = 0; i < 5; i++)
            {
                if (!_diceHeld[i])
                {
                    _diceValues[i] = _rand.Next(1, 7);
                }
            }
            StateHasChanged();
            await Task.Delay(60);
        }

        _diceRollsLeft--;
        _isPlaying = false;
        StateHasChanged();
    }

    private void ToggleDiceHold(int index)
    {
        if (!_diceGameActive || _diceValues[index] == 0) return;
        _diceHeld[index] = !_diceHeld[index];
        StateHasChanged();
    }

    private Dictionary<string, decimal> GetAvailableCombinations()
    {
        var combos = new Dictionary<string, decimal>();
        var values = _diceValues.Where(v => v > 0).ToArray();
        if (values.Length < 5) return combos;

        var groups = values.GroupBy(v => v).OrderByDescending(g => g.Count()).ToList();
        var sorted = values.OrderBy(v => v).ToArray();

        // Check each combination
        // Pair
        if (groups.Any(g => g.Count() >= 2))
            combos["Пара"] = _diceCurrentBet * 1;

        // Two Pairs
        if (groups.Count(g => g.Count() >= 2) >= 2)
            combos["2 Пары"] = _diceCurrentBet * 2;

        // Three of a kind
        if (groups.Any(g => g.Count() >= 3))
            combos["Тройка"] = _diceCurrentBet * 3;

        // Small Straight (1-2-3-4-5) or (2-3-4-5-6)
        if ((sorted.SequenceEqual(new[] {1,2,3,4,5})) || (sorted.SequenceEqual(new[] {2,3,4,5,6})))
            combos["Стрит"] = _diceCurrentBet * 4;

        // Full House (3 + 2)
        if (groups.Count == 2 && groups[0].Count() == 3)
            combos["Фулл-хаус"] = _diceCurrentBet * 5;

        // Four of a kind
        if (groups.Any(g => g.Count() >= 4))
            combos["Каре"] = _diceCurrentBet * 8;

        // Yahtzee (5 of a kind)
        if (groups.Any(g => g.Count() == 5))
            combos["ПОКЕР!"] = _diceCurrentBet * 20;

        // Always allow sum scoring
        combos["Сумма"] = values.Sum() * (_diceCurrentBet / 21m); // Proportional payout

        return combos;
    }

    private void ScoreDice()
    {
        if (Player == null || !_diceGameActive || string.IsNullOrEmpty(_selectedCombination)) return;

        var combos = GetAvailableCombinations();
        
        if (combos.TryGetValue(_selectedCombination, out var winnings))
        {
            _lastWin = true;
            _lastGameResult = $"🎲 {_selectedCombination}! Выигрыш: {winnings:C}!";
            Player.Money += winnings;
            _totalProfit += winnings;
            _wins++;
        }
        else
        {
            _lastWin = false;
            _lastGameResult = $"😢 {_selectedCombination} не найдено. Ставка потеряна.";
            Player.Money -= _diceCurrentBet;
            _totalProfit -= _diceCurrentBet;
        }

        _gamesPlayed++;
        _diceGameActive = false;
        _selectedCombination = null;
        StateHasChanged();
    }

    // Interactive Blackjack Methods
    private int DrawCard()
    {
        return _rand.Next(1, 14); // 1-13 (A, 2-10, J, Q, K)
    }

    private int GetCardValue(int card)
    {
        if (card >= 10) return 10; // J, Q, K = 10
        if (card == 1) return 11;   // Ace = 11 (will be adjusted in total)
        return card;
    }

    private int GetPlayerTotal()
    {
        return CalculateHandTotal(_bjPlayerCards);
    }

    private string GetCardTotal(List<int> cards, bool showAll)
    {
        if (!cards.Any()) return "";
        if (!showAll && cards.Count >= 2)
        {
            return $"({GetCardValue(cards[0])} + ?)";
        }
        return $"({CalculateHandTotal(cards)})";
    }

    private int CalculateHandTotal(List<int> cards)
    {
        int total = 0;
        int aces = 0;
        
        foreach (var card in cards)
        {
            if (card == 1) aces++;
            total += GetCardValue(card);
        }
        
        // Adjust aces if over 21
        while (total > 21 && aces > 0)
        {
            total -= 10;
            aces--;
        }
        
        return total;
    }

    private RenderFragment RenderCard(int cardValue) => builder =>
    {
        var suit = CardSuits[_rand.Next(CardSuits.Length)];
        var value = cardValue <= 13 && cardValue >= 1 ? CardValues[cardValue - 1] : "?";
        var isRed = suit == "♥" || suit == "♦";
        
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "playing-card");
        builder.AddAttribute(2, "style", $"width: 50px; height: 70px; background: white; border-radius: 5px; display: flex; flex-direction: column; align-items: center; justify-content: center; color: {(isRed ? "red" : "black")}; font-weight: bold; border: 1px solid #ccc;");
        
        builder.OpenElement(3, "div");
        builder.AddAttribute(4, "style", "font-size: 1.2rem;");
        builder.AddContent(5, value);
        builder.CloseElement();
        
        builder.OpenElement(6, "div");
        builder.AddAttribute(7, "style", "font-size: 0.9rem;");
        builder.AddContent(8, suit);
        builder.CloseElement();
        
        builder.CloseElement();
    };

    private async Task DealBlackjack()
    {
        if (Player == null || _isPlaying || _bjGameActive) return;

        // Validate bet
        if (_betAmount > Player.Money)
        {
            _lastGameResult = "💸 Недостаточно денег для ставки!";
            _lastWin = false;
            StateHasChanged();
            return;
        }

        _isPlaying = true;
        ClearGameState();
        _bjPlayerCards.Clear();
        _bjDealerCards.Clear();
        _bjCurrentBet = _betAmount;
        _bjDealerCardHidden = true;
        
        StateHasChanged();
        await Task.Delay(300);

        // Deal initial cards
        _bjPlayerCards.Add(DrawCard());
        StateHasChanged();
        await Task.Delay(200);
        
        _bjDealerCards.Add(DrawCard());
        StateHasChanged();
        await Task.Delay(200);
        
        _bjPlayerCards.Add(DrawCard());
        StateHasChanged();
        await Task.Delay(200);
        
        _bjDealerCards.Add(DrawCard());
        StateHasChanged();
        
        _bjGameActive = true;
        _isPlaying = false;

        // Check for natural blackjack
        if (GetPlayerTotal() == 21)
        {
            await BlackjackStand(); // Auto-stand on blackjack
        }
        else
        {
            StateHasChanged();
        }
    }

    private async Task BlackjackHit()
    {
        if (Player == null || !_bjGameActive || _isPlaying) return;

        _isPlaying = true;
        StateHasChanged();
        await Task.Delay(200);

        _bjPlayerCards.Add(DrawCard());
        _isPlaying = false;

        var playerTotal = GetPlayerTotal();
        
        if (playerTotal > 21)
        {
            // Bust!
            await EndBlackjackGame(false, "💥 Перебор! Ты проиграл.");
        }
        else if (playerTotal == 21)
        {
            // Auto-stand on 21
            await BlackjackStand();
        }
        else
        {
            StateHasChanged();
        }
    }

    private async Task BlackjackStand()
    {
        if (Player == null || !_bjGameActive) return;

        _isPlaying = true;
        _bjDealerCardHidden = false;
        StateHasChanged();
        await Task.Delay(500);

        // Dealer draws until 17+
        while (CalculateHandTotal(_bjDealerCards) < 17)
        {
            _bjDealerCards.Add(DrawCard());
            StateHasChanged();
            await Task.Delay(400);
        }

        var playerTotal = GetPlayerTotal();
        var dealerTotal = CalculateHandTotal(_bjDealerCards);

        bool won;
        string message;

        if (dealerTotal > 21)
        {
            won = true;
            message = $"🎉 Дилер перебрал! Ты выиграл {_bjCurrentBet:C}!";
        }
        else if (playerTotal > dealerTotal)
        {
            won = true;
            message = $"🎉 {playerTotal} > {dealerTotal}! Ты выиграл {_bjCurrentBet:C}!";
        }
        else if (playerTotal < dealerTotal)
        {
            won = false;
            message = $"😢 {playerTotal} < {dealerTotal}. Ты проиграл {_bjCurrentBet:C}.";
        }
        else
        {
            // Push - return bet
            _lastGameResult = $"🤝 Ничья! {playerTotal} = {dealerTotal}. Ставка возвращена.";
            _lastWin = false;
            _lastPlayerCards = playerTotal;
            _lastDealerCards = dealerTotal;
            _bjGameActive = false;
            _isPlaying = false;
            _gamesPlayed++;
            StateHasChanged();
            return;
        }

        await EndBlackjackGame(won, message);
    }

    private async Task EndBlackjackGame(bool won, string message)
    {
        _lastWin = won;
        _lastGameResult = message;
        _lastPlayerCards = GetPlayerTotal();
        _lastDealerCards = CalculateHandTotal(_bjDealerCards);
        _bjDealerCardHidden = false;
        _bjGameActive = false;
        _gamesPlayed++;

        if (won)
        {
            _wins++;
            Player!.Money += _bjCurrentBet;
            _totalProfit += _bjCurrentBet;
        }
        else
        {
            Player!.Money -= _bjCurrentBet;
            _totalProfit -= _bjCurrentBet;
        }

        _isPlaying = false;
        StateHasChanged();
        await Task.Delay(100);
    }

    private async Task PlayBlackjackEnhanced()
    {
        // Legacy method - redirect to new interactive version
        await DealBlackjack();
    }

    private async Task PlayRouletteEnhanced(string betType)
    {
        if (Player == null || _isPlaying) return;

        _isPlaying = true;
        ClearGameState();
        StateHasChanged();

        // Animate wheel spinning
        for (int i = 0; i < 15; i++)
        {
            _lastRouletteResult = _rand.Next(0, 37);
            StateHasChanged();
            await Task.Delay(50 + i * 20);
        }

        var result = GameEngine.PlayRoulette(Player, _betAmount, betType, betType == "number" ? _rouletteNumber : null);
        
        // Extract actual result from response
        _lastRouletteResult = _rand.Next(0, 37);
        
        _lastWin = result.Contains("выиграл");
        _lastGameResult = result;
        _gamesPlayed++;
        if (_lastWin) 
        { 
            _wins++; 
            _totalProfit += _betAmount * (betType == "number" ? 34 : 1); 
        }
        else _totalProfit -= _betAmount;
        
        _isPlaying = false;
        StateHasChanged();
    }

    // Helper methods for visual display
    private string GetDiceFace(int value) => value switch
    {
        1 => "⚀",
        2 => "⚁",
        3 => "⚂",
        4 => "⚃",
        5 => "⚄",
        6 => "⚅",
        _ => "🎲"
    };

    private string GetRouletteColorClass(int number)
    {
        if (number == 0) return "bg-success text-white";
        return RedNumbers.Contains(number) ? "bg-danger text-white" : "bg-dark text-white";
    }

    private string GetStatusCardClass()
    {
        return Player?.IntoxicationLevel switch
        {
            0 => "",
            1 => "border-warning",
            2 => "border-warning",
            _ => "border-danger"
        };
    }

    private string GetIntoxicationBadgeClass()
    {
        return Player?.IntoxicationLevel switch
        {
            0 => "bg-success",
            1 => "bg-warning text-dark",
            2 => "bg-warning text-dark",
            3 => "bg-danger",
            _ => "bg-danger"
        };
    }
