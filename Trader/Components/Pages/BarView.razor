                       result.Contains("Ничья") ? "alert-warning" : "alert-danger";
        StateHasChanged();
    }

    private void PlayRoulette(string betType)
    {
        if (Player == null) return;

        var result = GameEngine.PlayRoulette(Player, _betAmount, betType, betType == "number" ? _rouletteNumber : null);
        _message = result;
        _messageClass = result.Contains("выиграл") ? "alert-success" : "alert-danger";
        StateHasChanged();
    }

    // Enhanced game methods with visual feedback
    private void SelectGame(string game)
    {
        _selectedGame = game;
        ClearGameState();
        StateHasChanged();
    }

    private void ClearGameState()
    {
        _lastGameResult = "";
        _lastDice1 = 0;
        _lastDice2 = 0;
        _lastPlayerCards = 0;
        _lastDealerCards = 0;
        _lastRouletteResult = -1;
    }

    private async Task PlaySlotsEnhanced()
    {
        if (Player == null || _isPlaying) return;

        _isPlaying = true;
        ClearGameState();
        StateHasChanged();

        // Animate slot reels
        for (int i = 0; i < 10; i++)
        {
            _slotSymbol1 = SlotSymbols[_rand.Next(SlotSymbols.Length)];
            _slotSymbol2 = SlotSymbols[_rand.Next(SlotSymbols.Length)];
            _slotSymbol3 = SlotSymbols[_rand.Next(SlotSymbols.Length)];
            StateHasChanged();
            await Task.Delay(100);
        }

        var result = GameEngine.PlayGambling(Player, _betAmount);
        _lastWin = result.Contains("Победа");
        _lastGameResult = result;
        _gamesPlayed++;
        if (_lastWin) { _wins++; _totalProfit += _betAmount; }
        else _totalProfit -= _betAmount;
        
        _isPlaying = false;
        StateHasChanged();
