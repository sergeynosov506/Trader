    // Interactive Dice: CONTRACT model — declare a target combination before rolling,
    // get paid only if you actually assemble it within 3 rolls.
    // (The old "pick any combination you happened to roll" version was +250% EV for the player.)
    public record DiceTarget(string Key, string LocKey, decimal Multiplier);

    private static readonly DiceTarget[] DiceTargets =
    {
        new("two_pairs",  "bar.combo_two_pair",   1.3m),
        new("trips",      "bar.combo_three",      1.25m),
        new("full_house", "bar.combo_full_house", 2.6m),
        new("four",       "bar.combo_four",       3.2m),
        new("straight",   "bar.combo_straight",   5m),
        new("yahtzee",    "bar.combo_poker",      20m),
    };

    private string? _diceTarget = null;
    private DiceTarget? CurrentDiceTarget => DiceTargets.FirstOrDefault(t => t.Key == _diceTarget);

    private bool IsDiceTargetAchieved()
    {
        var values = _diceValues.Where(v => v > 0).ToArray();
        if (values.Length < 5 || _diceTarget == null) return false;

        var groups = values.GroupBy(v => v).OrderByDescending(g => g.Count()).ToList();
        var sorted = values.OrderBy(v => v).ToArray();

        return _diceTarget switch
        {
            "two_pairs" => groups.Count(g => g.Count() >= 2) >= 2,
            "trips" => groups.Any(g => g.Count() >= 3),
            "full_house" => groups.Any(g => g.Count() >= 3) && groups.Count(g => g.Count() >= 2) >= 2,
            "four" => groups.Any(g => g.Count() >= 4),
            "straight" => sorted.SequenceEqual(new[] {1,2,3,4,5}) || sorted.SequenceEqual(new[] {2,3,4,5,6}),
            "yahtzee" => groups.Any(g => g.Count() == 5),
            _ => false
        };
    }

    private async Task StartDiceGame()
    {
        if (Player == null || _isPlaying || _diceGameActive || _diceTarget == null) return;

        if (_betAmount > Player.Money)
        {
            _lastGameResult = Loc["bar.insufficient_bet"];
            _lastWin = false;
            StateHasChanged();
            return;
        }

        var diceBetError = GameEngine.ValidateBet(Player, _betAmount);
        if (diceBetError != null)
        {
            _lastGameResult = diceBetError;
            _lastWin = false;
            StateHasChanged();
            return;
        }

        _diceGameActive = true;
        _diceCurrentBet = _betAmount;
        _diceRollsLeft = 3;
        _diceHeld = new bool[5];
        ClearGameState();

        await RollDice();
    }

    private void ResolveDice()
    {
        if (Player == null || !_diceGameActive || _isPlaying) return;
        var target = CurrentDiceTarget;
        if (target == null) return;

        if (IsDiceTargetAchieved())
        {
            decimal gross = _diceCurrentBet * target.Multiplier;
            var netResult = gross - _diceCurrentBet;
            var (paidDice, noteDice) = GameEngine.SettleGambling(Player, netResult);
            _lastWin = true;
            _wins++;
            _totalProfit += paidDice;
            _lastGameResult = string.Format(Loc["bar.dice_score_win"], Loc[target.LocKey], gross.ToString("C"))
                + (noteDice != null ? $" ({noteDice})" : "");
        }
        else
        {
            _lastWin = false;
            GameEngine.SettleGambling(Player, -_diceCurrentBet);
            _totalProfit -= _diceCurrentBet;
            _lastGameResult = string.Format(Loc["bar.dice_score_lose"], Loc[target.LocKey]);
        }

        _gamesPlayed++;
        _diceGameActive = false;
        _diceTarget = null;
        StateHasChanged();
    }

    private async Task RollDice()
    {
        if (!_diceGameActive || _diceRollsLeft <= 0 || _isPlaying) return;

        _isPlaying = true;
        StateHasChanged();

        // Animate rolling dice
        for (int anim = 0; anim < 8; anim++)
        {
            for (int i = 0; i < 5; i++)
            {
                if (!_diceHeld[i])
                {
                    _diceValues[i] = _rand.Next(1, 7);
                }
            }
            StateHasChanged();
            await Task.Delay(60);
        }

        _diceRollsLeft--;
        _isPlaying = false;

        // Out of rolls — the contract resolves automatically
        if (_diceRollsLeft <= 0)
        {
            ResolveDice();
            return;
        }
        StateHasChanged();
    }

