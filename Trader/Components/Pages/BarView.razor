    private async Task DrawPokerCards()
    {
        if (Player == null || !_pokerGameActive || _isPlaying) return;

        _isPlaying = true;
        
        string slipMessage = "";
        if (Player.IntoxicationLevel >= 2)
        {
            double slipChance = Player.IntoxicationLevel == 2 ? 0.15 : 0.30;
            List<string> slips = new();
            for (int i = 0; i < 5; i++)
            {
                if (_pokerHeld[i] && _rand.NextDouble() < slipChance)
                {
                    _pokerHeld[i] = false;
                    slips.Add(string.Format(Loc["bar.poker_drunk_slip"], i + 1));
                }
            }
            if (slips.Any())
            {
                slipMessage = string.Join(" ", slips);
            }
        }

        StateHasChanged();
        await Task.Delay(300);

        for (int i = 0; i < 5; i++)
        {
            if (!_pokerHeld[i])
            {
                _pokerHand[i] = _pokerDeck[0];
                _pokerDeck.RemoveAt(0);
                StateHasChanged();
                await Task.Delay(150);
            }
        }

        var combinationName = EvaluatePokerHand(_pokerHand, out decimal multiplier);
        
        _gamesPlayed++;
        if (multiplier > 0)
        {
            _lastWin = true;
            decimal netProfit = (multiplier - 1) * _pokerCurrentBet;
            var (paidPoker, notePoker) = GameEngine.SettleGambling(Player, netProfit);
            _totalProfit += paidPoker;
            _wins++;

            _lastGameResult = string.Format(Loc["bar.poker_win"], combinationName, (_pokerCurrentBet + paidPoker).ToString("C"))
                + (notePoker != null ? $" ({notePoker})" : "");
        }
        else
        {
            _lastWin = false;
            GameEngine.SettleGambling(Player, -_pokerCurrentBet);
            _totalProfit -= _pokerCurrentBet;
            _lastGameResult = Loc["bar.poker_lose"];
        }

        if (!string.IsNullOrEmpty(slipMessage))
        {
            _message = slipMessage;
            _messageClass = "alert-warning";
        }
        else
