@using EconomicGame
@using EconomicGame.Configuration
@inject EconomicGame.Services.GameEngine GameEngine
@inject EconomicGame.Services.CorporateActionService ActionService
@inject EconomicGame.Services.PlayerService PlayerService

<div class="bar">
    <h2>🍺 Бар "У Трейдера"</h2>
    
    @if (Player == null)
    {
        <p>Создайте персонажа для посещения бара.</p>
    }
    else
    {
        <div class="row mb-4">
            <!-- Status panel -->
            <div class="col-md-4">
                <div class="card @GetStatusCardClass()">
                    <div class="card-header">
                        <h5>Твоё состояние</h5>
                    </div>
                    <div class="card-body">
                        <p><strong>Деньги:</strong> @Player.Money.ToString("C")</p>
                        <p>
                            <strong>Состояние:</strong> 
                            <span class="badge @GetIntoxicationBadgeClass()">
                                @GameEngine.GetIntoxicationStatus(Player)
                            </span>
                        </p>
                        @if (Player.SoberUpTime.HasValue)
                        {
                            <p class="text-muted small">
                                Протрезвеешь к: @Player.SoberUpTime.Value.ToShortTimeString()
                            </p>
                        }
                        @if (Player.IntoxicationLevel >= 3)
                        {
                            <div class="alert alert-warning py-1 small">
                                ⚠️ Осторожно! В пьяном виде шансы на выигрыш ниже!
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Drink menu -->
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header bg-warning text-dark">
                        <h5>🍻 Меню напитков</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="card text-center h-100">
                                    <div class="card-body">
                                        <h1>🍺</h1>
                                        <h6>Пиво</h6>
                                        <p class="text-muted">@GameConstants.BeerPrice.ToString("C")</p>
                                        <button class="btn btn-outline-primary btn-sm" 
                                                @onclick='() => OrderDrink("beer")'>
                                            Заказать
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card text-center h-100">
                                    <div class="card-body">
                                        <h1>🥃</h1>
                                        <h6>Виски</h6>
                                        <p class="text-muted">@GameConstants.WhiskeyPrice.ToString("C")</p>
                                        <button class="btn btn-outline-warning btn-sm" 
                                                @onclick='() => OrderDrink("whiskey")'>
                                            Заказать
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card text-center h-100">
                                    <div class="card-body">
                                        <h1>🍹</h1>
                                        <h6>Коктейль</h6>
                                        <p class="text-muted">@GameConstants.CocktailPrice.ToString("C")</p>
                                        <button class="btn btn-outline-danger btn-sm" 
                                                @onclick='() => OrderDrink("cocktail")'>
                                            Заказать
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Message display -->
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @_messageClass mb-4">
                @_message
            </div>
        }

        <div class="row">
            <!-- Social -->
            <div class="col-md-6">
                <div class="card mb-3">
                    <div class="card-header bg-info text-white">
                        <h5>👥 Общение</h5>
                    </div>
                    <div class="card-body">
                        <p>Поговори с посетителями — может найдёшь выгодную сделку!</p>
                        <button class="btn btn-info" @onclick="TryMeetSomeone" 
                                disabled="@(Player.IntoxicationLevel == 0)">
                            Подойти к кому-нибудь
                        </button>
                        @if (Player.IntoxicationLevel == 0)
                        {
                            <p class="text-muted small mt-2">Закажи выпить, чтобы раскрепоститься!</p>
                        }

                        @if (_hasActiveDeal)
                        {
                            <div class="alert alert-success mt-3">
                                <strong>💰 Предложение!</strong><br/>
                                @_dealDescription<br/>
                                <strong>Итого:</strong> @((_dealPrice ?? 0) * (_dealQuantity ?? 0)):C
                                <div class="mt-2">
                                    <button class="btn btn-success btn-sm" @onclick="AcceptDeal">
                                        ✅ Принять
                                    </button>
                                    <button class="btn btn-secondary btn-sm" @onclick="DeclineDeal">
                                        ❌ Отказаться
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Gambling Games - Enhanced -->
            <div class="col-md-6">
                <div class="card mb-3 game-card" style="background: linear-gradient(145deg, #1a1a2e 0%, #16213e 100%); border: 2px solid #e94560;">
                    <div class="card-header text-white" style="background: linear-gradient(90deg, #e94560, #0f3460);">
                        <h5 class="mb-0">🎰 Казино "Удача"</h5>
                    </div>
                    <div class="card-body text-white">
                        <!-- Game tabs with neon style -->
                        <ul class="nav nav-pills mb-3 justify-content-center">
                            <li class="nav-item">
                                <a class="nav-link @(_selectedGame == "slots" ? "active bg-danger" : "text-light")" 
                                   href="#" @onclick='() => SelectGame("slots")' @onclick:preventDefault
                                   style="@(_selectedGame != "slots" ? "border: 1px solid #e94560;" : "")">
                                   🎰 Слоты
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(_selectedGame == "dice" ? "active bg-warning text-dark" : "text-light")" 
                                   href="#" @onclick='() => SelectGame("dice")' @onclick:preventDefault
                                   style="@(_selectedGame != "dice" ? "border: 1px solid #ffc107;" : "")">
                                   🎲 Кости
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(_selectedGame == "blackjack" ? "active bg-dark" : "text-light")" 
                                   href="#" @onclick='() => SelectGame("blackjack")' @onclick:preventDefault
                                   style="@(_selectedGame != "blackjack" ? "border: 1px solid #6c757d;" : "")">
                                   🃏 Блэкджек
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(_selectedGame == "roulette" ? "active bg-success" : "text-light")" 
                                   href="#" @onclick='() => SelectGame("roulette")' @onclick:preventDefault
                                   style="@(_selectedGame != "roulette" ? "border: 1px solid #198754;" : "")">
                                   🎡 Рулетка
                                </a>
                            </li>
                        </ul>

                        <!-- Game Display Area -->
                        <div class="game-display text-center p-3 mb-3 rounded" 
                             style="background: rgba(0,0,0,0.3); min-height: 120px; border: 1px solid rgba(255,255,255,0.1);">
                            
                            @if (_isPlaying)
                            {
                                <div class="spinner-grow text-warning" role="status">
                                    <span class="visually-hidden">Playing...</span>
                                </div>
                                <p class="mt-2 text-warning">🎲 Играем...</p>
                            }
                            else if (_bjGameActive && _selectedGame == "blackjack")
                            {
                                <!-- Active Blackjack Game - Show cards during play -->
                                <div class="blackjack-table">
                                    <!-- Dealer's cards -->
                                    <div class="dealer-area mb-3">
                                        <div class="text-muted small mb-1">Дилер @(GetCardTotal(_bjDealerCards, !_bjDealerCardHidden))</div>
                                        <div class="d-flex justify-content-center gap-2">
                                            @for (int i = 0; i < _bjDealerCards.Count; i++)
                                            {
                                                @if (i == 1 && _bjDealerCardHidden)
                                                {
                                                    <div class="playing-card card-back" style="width: 50px; height: 70px; background: linear-gradient(135deg, #1a1a2e, #16213e); border: 2px solid gold; border-radius: 5px; display: flex; align-items: center; justify-content: center;">
                                                        <span style="font-size: 1.5rem;">🎴</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    @RenderCard(_bjDealerCards[i])
                                                }
                                            }
                                        </div>
                                    </div>
                                    
                                    <div class="text-warning mb-2">vs</div>
                                    
                                    <!-- Player's cards -->
                                    <div class="player-area">
                                        <div class="d-flex justify-content-center gap-2 mb-1">
                                            @foreach (var card in _bjPlayerCards)
                                            {
                                                @RenderCard(card)
                                            }
                                        </div>
                                        <div class="text-info">Твои карты: <strong class="h4">@GetPlayerTotal()</strong></div>
                                    </div>
                                </div>
                            }
                            else if (_diceGameActive && _selectedGame == "dice")
                            {
                                <!-- Active Yahtzee Dice Game - Show dice during play -->
                                <div class="yahtzee-dice">
                                    <div class="d-flex justify-content-center gap-2 mb-2">
                                        @for (int i = 0; i < 5; i++)
                                        {
                                            var idx = i;
                                            <div class="dice-container" @onclick="() => ToggleDiceHold(idx)" style="cursor: pointer;">
                                                <div class="dice @(_diceHeld[idx] ? "held" : "")" 
                                                     style="width: 55px; height: 55px; background: @(_diceHeld[idx] ? "#28a745" : "white"); 
                                                            border-radius: 8px; display: flex; align-items: center; justify-content: center; 
                                                            font-size: 2rem; border: 3px solid @(_diceHeld[idx] ? "#1e7e34" : "#ccc");
                                                            box-shadow: @(_diceHeld[idx] ? "0 0 10px rgba(40,167,69,0.5)" : "2px 2px 5px rgba(0,0,0,0.2)");
                                                            transition: all 0.2s;">
                                                    @GetDiceFace(_diceValues[idx])
                                                </div>
                                                @if (_diceHeld[idx])
                                                {
                                                    <div class="text-success small mt-1">🔒</div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="text-info">Сумма: <strong>@_diceValues.Sum()</strong></div>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(_lastGameResult))
                            {
                                @if (_selectedGame == "dice" && _diceGameActive)
                                {
                                    <!-- Interactive 5-Dice Display -->
                                    <div class="yahtzee-dice">
                                        <div class="d-flex justify-content-center gap-2 mb-2">
                                            @for (int i = 0; i < 5; i++)
                                            {
                                                var idx = i;
                                                <div class="dice-container" @onclick="() => ToggleDiceHold(idx)" style="cursor: pointer;">
                                                    <div class="dice @(_diceHeld[idx] ? "held" : "")" 
                                                         style="width: 55px; height: 55px; background: @(_diceHeld[idx] ? "#28a745" : "white"); 
                                                                border-radius: 8px; display: flex; align-items: center; justify-content: center; 
                                                                font-size: 2rem; border: 3px solid @(_diceHeld[idx] ? "#1e7e34" : "#ccc");
                                                                box-shadow: @(_diceHeld[idx] ? "0 0 10px rgba(40,167,69,0.5)" : "2px 2px 5px rgba(0,0,0,0.2)");
                                                                transition: all 0.2s;">
                                                        @GetDiceFace(_diceValues[idx])
                                                    </div>
                                                    @if (_diceHeld[idx])
                                                    {
                                                        <div class="text-success small mt-1">🔒</div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        <div class="text-info">Сумма: <strong>@_diceValues.Sum()</strong></div>
                                    </div>
                                }
                                else if (_selectedGame == "dice" && _lastDice1 > 0)
                                {
                                    <div class="dice-display mb-2">
                                        <span class="dice-face" style="font-size: 3rem; margin: 0 10px;">@GetDiceFace(_lastDice1)</span>
                                        <span class="dice-face" style="font-size: 3rem; margin: 0 10px;">@GetDiceFace(_lastDice2)</span>
                                    </div>
                                    <p class="h4">Сумма: @(_lastDice1 + _lastDice2)</p>
                                }
                                else if (_selectedGame == "blackjack" && (_bjGameActive || _lastPlayerCards > 0))
                                {
                                    <!-- Interactive Blackjack Display -->
                                    <div class="blackjack-table">
                                        <!-- Dealer's cards -->
                                        <div class="dealer-area mb-3">
                                            <div class="text-muted small mb-1">Дилер @(GetCardTotal(_bjDealerCards, !_bjDealerCardHidden))</div>
                                            <div class="d-flex justify-content-center gap-2">
                                                @for (int i = 0; i < _bjDealerCards.Count; i++)
                                                {
                                                    @if (i == 1 && _bjDealerCardHidden)
                                                    {
                                                        <div class="playing-card card-back" style="width: 50px; height: 70px; background: linear-gradient(135deg, #1a1a2e, #16213e); border: 2px solid gold; border-radius: 5px; display: flex; align-items: center; justify-content: center;">
                                                            <span style="font-size: 1.5rem;">🎴</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        @RenderCard(_bjDealerCards[i])
                                                    }
                                                }
                                            </div>
                                        </div>
                                        
                                        <div class="text-warning mb-2">vs</div>
                                        
                                        <!-- Player's cards -->
                                        <div class="player-area">
                                            <div class="d-flex justify-content-center gap-2 mb-1">
                                                @foreach (var card in _bjPlayerCards)
                                                {
                                                    @RenderCard(card)
                                                }
                                            </div>
                                            <div class="text-info">Твои карты: <strong class="h4">@GetPlayerTotal()</strong></div>
                                        </div>
                                    </div>
                                }
                                else if (_selectedGame == "roulette" && _lastRouletteResult >= 0)
                                {
                                    <div class="roulette-display mb-2">
                                        <div class="roulette-number @GetRouletteColorClass(_lastRouletteResult)" 
                                             style="display: inline-block; width: 80px; height: 80px; line-height: 80px; border-radius: 50%; font-size: 2rem; font-weight: bold;">
                                            @_lastRouletteResult
                                        </div>
                                    </div>
                                }
                                else if (_selectedGame == "slots")
                                {
                                    <div class="slots-display mb-2">
                                        <span style="font-size: 3rem;">@_slotSymbol1</span>
                                        <span style="font-size: 3rem;">@_slotSymbol2</span>
                                        <span style="font-size: 3rem;">@_slotSymbol3</span>
                                    </div>
                                }
                            }
                            else
                            {
                                @if (_selectedGame == "slots")
                                {
                                    <div style="font-size: 3rem;">🍒 🍋 🍇</div>
                                    <p class="text-muted">Крути барабаны!</p>
                                }
                                else if (_selectedGame == "dice")
                                {
                                    <div style="font-size: 3rem;">⚀ ⚁ ⚂ ⚃ ⚄ ⚅</div>
                                    <p class="text-muted">Брось кубики!</p>
                                }
                                else if (_selectedGame == "blackjack")
                                {
                                    <div style="font-size: 3rem;">🂡 🂫 🂭 🂮</div>
                                    <p class="text-muted">Попробуй обыграть дилера!</p>
                                }
                                else if (_selectedGame == "roulette")
                                {
                                    <div style="font-size: 3rem;">🔴 ⚫ 🟢</div>
                                    <p class="text-muted">Делайте ваши ставки!</p>
                                }
                            }
                        </div>

                        <!-- Result message -->
                        @if (!string.IsNullOrEmpty(_lastGameResult))
                        {
                            <div class="alert @(_lastWin ? "alert-success" : "alert-danger") py-2 mb-3 @(_lastWin ? "animate-win" : "")">
                                @if (_lastWin)
                                {
                                    <span style="font-size: 1.5rem;">🎉</span>
                                }
                                @_lastGameResult
                                @if (_lastWin)
                                {
                                    <span style="font-size: 1.5rem;">🎉</span>
                                }
                            </div>
                        }

                        <!-- Bet amount with styled input -->
                        <div class="mb-3">
                            <div class="input-group">
                                <span class="input-group-text bg-dark text-warning border-warning">💰 Ставка</span>
                                <input type="number" @bind="_betAmount" class="form-control bg-dark text-white border-warning text-center" 
                                       min="@GameConstants.GamblingMinBet" 
                                       max="@GameConstants.GamblingMaxBet" step="50" />
                                <span class="input-group-text bg-dark text-muted border-warning">$</span>
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <button class="btn btn-sm btn-outline-secondary text-light" @onclick="() => _betAmount = 50">$50</button>
                                <button class="btn btn-sm btn-outline-secondary text-light" @onclick="() => _betAmount = 100">$100</button>
                                <button class="btn btn-sm btn-outline-secondary text-light" @onclick="() => _betAmount = 250">$250</button>
                                <button class="btn btn-sm btn-outline-secondary text-light" @onclick="() => _betAmount = 500">$500</button>
                            </div>
                        </div>

                        <!-- Game-specific controls -->
                        @if (_selectedGame == "slots")
                        {
                            <button class="btn btn-lg btn-danger w-100 py-3" @onclick="PlaySlotsEnhanced" disabled="@_isPlaying"
                                    style="background: linear-gradient(180deg, #e94560, #c73659); border: none; box-shadow: 0 4px 15px rgba(233,69,96,0.4);">
                                <span style="font-size: 1.5rem;">🎰</span> КРУТИТЬ! <span style="font-size: 1.5rem;">🎰</span>
                            </button>
                        }
                        else if (_selectedGame == "dice")
                        {
                            @if (!_diceGameActive)
                            {
                                <!-- Start new dice game -->
                                <button class="btn btn-lg btn-warning w-100 py-3" @onclick="StartDiceGame" disabled="@_isPlaying"
                                        style="background: linear-gradient(180deg, #ffc107, #e0a800); border: none; box-shadow: 0 4px 15px rgba(255,193,7,0.4);">
                                    <span style="font-size: 1.5rem;">🎲</span> БРОСИТЬ КОСТИ <span style="font-size: 1.5rem;">🎲</span>
                                </button>
                                
                                <!-- Combination payouts -->
                                <div class="mt-3 small text-muted">
                                    <div class="row text-start">
                                        <div class="col-6">Пара: x1</div>
                                        <div class="col-6">Две пары: x2</div>
                                        <div class="col-6">Тройка: x3</div>
                                        <div class="col-6">Стрит: x4</div>
                                        <div class="col-6">Фулл-хаус: x5</div>
                                        <div class="col-6">Каре: x8</div>
                                        <div class="col-6">Покер (5): x20</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Active dice game -->
                                <div class="text-info small mb-2">
                                    🎲 Бросков осталось: <strong>@_diceRollsLeft</strong> | 💰 Ставка: @_diceCurrentBet.ToString("C")
                                </div>
                                <p class="text-muted small">Нажми на кубик чтобы сохранить его</p>
                                
                                <button class="btn btn-warning w-100 mb-3" @onclick="RollDice" disabled="@(_isPlaying || _diceRollsLeft <= 0)"
                                        style="box-shadow: 0 4px 10px rgba(255,193,7,0.3);">
                                    🎲 БРОСИТЬ (@_diceRollsLeft осталось)
                                </button>
                                
                                <!-- Combination selector -->
                                <div class="mb-2 text-light small">Выбери комбинацию для подсчёта:</div>
                                <div class="row g-1 mb-2">
                                    @foreach (var combo in GetAvailableCombinations())
                                    {
                                        <div class="col-4">
                                            <button class="btn btn-sm w-100 @(_selectedCombination == combo.Key ? "btn-success" : "btn-outline-light")" 
                                                    @onclick="() => _selectedCombination = combo.Key">
                                                @combo.Key<br/><small class="text-warning">@combo.Value.ToString("C")</small>
                                            </button>
                                        </div>
                                    }
                                </div>
                                
                                <button class="btn btn-success w-100" @onclick="ScoreDice" 
                                        disabled="@(string.IsNullOrEmpty(_selectedCombination))"
                                        style="box-shadow: 0 4px 10px rgba(40,167,69,0.3);">
                                    💰 ЗАБРАТЬ ВЫИГРЫШ
                                </button>
                            }
                        }
                        else if (_selectedGame == "blackjack")
                        {
                            @if (!_bjGameActive)
                            {
                                <button class="btn btn-lg btn-dark w-100 py-3" @onclick="DealBlackjack" disabled="@_isPlaying"
                                        style="background: linear-gradient(180deg, #2d3436, #000000); border: 2px solid gold; box-shadow: 0 4px 15px rgba(255,215,0,0.3);">
                                    <span style="font-size: 1.5rem;">🃏</span> РАЗДАТЬ КАРТЫ <span style="font-size: 1.5rem;">🃏</span>
                                </button>
                            }
                            else
                            {
                                <!-- Interactive Hit/Stand controls -->
                                <div class="row g-2">
                                    <div class="col-6">
                                        <button class="btn btn-lg btn-success w-100 py-3" @onclick="BlackjackHit" disabled="@_isPlaying"
                                                style="box-shadow: 0 4px 15px rgba(40,167,69,0.4);">
                                            <span style="font-size: 1.5rem;">👆</span> ЕЩЁ
                                            <div class="small">Hit</div>
                                        </button>
                                    </div>
                                    <div class="col-6">
                                        <button class="btn btn-lg btn-danger w-100 py-3" @onclick="BlackjackStand" disabled="@_isPlaying"
                                                style="box-shadow: 0 4px 15px rgba(220,53,69,0.4);">
                                            <span style="font-size: 1.5rem;">✋</span> ХВАТИТ
                                            <div class="small">Stand</div>
                                        </button>
                                    </div>
                                </div>
                                <div class="mt-2 text-warning small">
                                    💰 Ставка: @_bjCurrentBet.ToString("C")
                                </div>
                            }
                        }
                        else if (_selectedGame == "roulette")
                        {
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <button class="btn btn-lg btn-danger w-100 py-3" @onclick='() => PlayRouletteEnhanced("red")' disabled="@_isPlaying"
                                            style="box-shadow: 0 4px 15px rgba(220,53,69,0.4);">
                                        🔴 КРАСНОЕ (x2)
                                    </button>
                                </div>
                                <div class="col-6">
                                    <button class="btn btn-lg btn-dark w-100 py-3" @onclick='() => PlayRouletteEnhanced("black")' disabled="@_isPlaying"
                                            style="box-shadow: 0 4px 15px rgba(0,0,0,0.4);">
                                        ⚫ ЧЁРНОЕ (x2)
                                    </button>
                                </div>
                            </div>
                            <div class="input-group">
                                <input type="number" @bind="_rouletteNumber" class="form-control bg-dark text-white border-success text-center" 
                                       min="0" max="36" placeholder="0-36" style="font-size: 1.2rem;" />
                                <button class="btn btn-success px-4" @onclick='() => PlayRouletteEnhanced("number")' disabled="@_isPlaying"
                                        style="box-shadow: 0 4px 15px rgba(25,135,84,0.4);">
                                    🎯 НОМЕР (x35)
                                </button>
                            </div>
                        }

                        @if (Player.IntoxicationLevel >= 2)
                        {
                            <div class="alert alert-warning py-1 mt-3 small">
                                🍺 Опьянение снижает шансы! Уровень: @Player.IntoxicationLevel
                            </div>
                        }

                        <!-- Win streak / Stats -->
                        @if (_gamesPlayed > 0)
                        {
                            <div class="mt-3 pt-2 border-top border-secondary small text-muted">
                                <span>Игр: @_gamesPlayed</span> |
                                <span class="text-success">Выигрыши: @_wins</span> |
                                <span class="text-danger">Проигрыши: @(_gamesPlayed - _wins)</span> |
                                <span class="@(_totalProfit >= 0 ? "text-success" : "text-danger")">
                                    @(_totalProfit >= 0 ? "+" : "")@_totalProfit.ToString("C")
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Rumors heard -->
        @if (_heardRumors.Any())
        {
            <div class="card mt-3">
                <div class="card-header bg-secondary text-white">
                    <h5>👂 Услышанные слухи</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group">
                        @foreach (var rumor in _heardRumors)
                        {
                            <li class="list-group-item">💬 @rumor</li>
                        }
                    </ul>
                </div>
            </div>
        }

        <!-- Phase 7: Shadow Operations -->
        <div class="card mt-3" style="background: #0d0d0d; border: 1px solid #333;">
            <div class="card-header text-white" style="background: #1a1a1a;">
                <h5 class="mb-0">🕵️‍♂️ Теневые операции</h5>
            </div>
            <div class="card-body text-light">
                <p class="text-muted small">Здесь можно нанять людей для решения "особых" проблем с конкурентами.</p>
                
                @if (Player.RivalPlayerIds.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover table-sm">
                            <thead>
                                <tr>
                                    <th>Конкурент</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rivalId in Player.RivalPlayerIds)
                                {
                                    var rival = PlayerService.GetAllPlayers().FirstOrDefault(p => p.Id == rivalId);
                                    if (rival != null)
                                    {
                                        <tr>
                                            <td>
                                                <span class="text-danger fw-bold">@rival.Name</span>
                                                @if (rival.IsSabotaged)
                                                {
                                                    <span class="badge bg-warning text-dark ms-1">Саботаж</span>
                                                }
                                                @if (rival.OwnerId == Player.Id)
                                                {
                                                    <span class="badge bg-success ms-1">Твое подразделение</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group">
                                                    <button class="btn btn-outline-info btn-sm" 
                                                            @onclick="() => GetIntel(rival.Id)">
                                                        👁️ Разведка ($5k)
                                                    </button>
                                                    <button class="btn btn-outline-warning btn-sm" 
                                                            @onclick="() => Sabotage(rival.Id)"
                                                            disabled="@(rival.IsSabotaged || rival.OwnerId == Player.Id)">
                                                        🧨 Саботаж (@ActionService.CalculateSabotageCost(rival).ToString("C0"))
                                                    </button>
                                                    <button class="btn btn-outline-danger btn-sm" 
                                                            @onclick="() => Takeover(rival.Id)"
                                                            disabled="@(rival.OwnerId != null)">
                                                        🏢 Поглощение
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted italic">Пока у тебя нет серьезных врагов на рынке...</p>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
