    private async Task DealBlackjack()
    {
        if (Player == null || _isPlaying || _bjGameActive) return;

        // Validate bet
        if (_betAmount > Player.Money)
        {
            _lastGameResult = Loc["bar.insufficient_bet"];
            _lastWin = false;
            StateHasChanged();
            return;
        }

        var bjBetError = GameEngine.ValidateBet(Player, _betAmount);
        if (bjBetError != null)
        {
            _lastGameResult = bjBetError;
            _lastWin = false;
            StateHasChanged();
            return;
        }

        _isPlaying = true;
        ClearGameState();
        _bjPlayerCards.Clear();
        _bjDealerCards.Clear();
        _bjCurrentBet = _betAmount;
        _bjDealerCardHidden = true;
        
        StateHasChanged();
        await Task.Delay(300);

        // Deal initial cards
        _bjPlayerCards.Add(DrawCard());
        StateHasChanged();
        await Task.Delay(200);
        
        _bjDealerCards.Add(DrawCard());
        StateHasChanged();
        await Task.Delay(200);
        
        _bjPlayerCards.Add(DrawCard());
        StateHasChanged();
        await Task.Delay(200);
        
        _bjDealerCards.Add(DrawCard());
        StateHasChanged();
        
        _bjGameActive = true;
        _isPlaying = false;

        // Check for natural blackjack
        if (GetPlayerTotal() == 21)
        {
            await BlackjackStand(); // Auto-stand on blackjack
        }
        else
        {
            StateHasChanged();
        }
    }

    private async Task BlackjackHit()
    {
        if (Player == null || !_bjGameActive || _isPlaying) return;

        _isPlaying = true;
        StateHasChanged();
        await Task.Delay(200);

        _bjPlayerCards.Add(DrawCard());
        _isPlaying = false;

        var playerTotal = GetPlayerTotal();
        
        if (playerTotal > 21)
        {
            // Bust!
            await EndBlackjackGame(false, Loc["bar.bust"]);
        }
        else if (playerTotal == 21)
        {
            // Auto-stand on 21
            await BlackjackStand();
        }
        else
        {
            StateHasChanged();
        }
    }

    private async Task BlackjackStand()
    {
        if (Player == null || !_bjGameActive) return;

        _isPlaying = true;
        _bjDealerCardHidden = false;
        StateHasChanged();
        await Task.Delay(500);

        // Dealer draws until 17+
        while (CalculateHandTotal(_bjDealerCards) < 17)
        {
            _bjDealerCards.Add(DrawCard());
            StateHasChanged();
            await Task.Delay(400);
        }

        var playerTotal = GetPlayerTotal();
        var dealerTotal = CalculateHandTotal(_bjDealerCards);

        bool won;
        string message;

        if (dealerTotal > 21)
        {
            won = true;
            message = string.Format(Loc["bar.dealer_bust"], _bjCurrentBet.ToString("C"));
        }
        else if (playerTotal > dealerTotal)
        {
            won = true;
            message = string.Format(Loc["bar.you_won"], playerTotal, dealerTotal, _bjCurrentBet.ToString("C"));
        }
        else if (playerTotal < dealerTotal)
        {
            won = false;
            message = string.Format(Loc["bar.you_lost"], playerTotal, dealerTotal, _bjCurrentBet.ToString("C"));
        }
        else
        {
            // Push - return bet
            _lastGameResult = string.Format(Loc["bar.push"], playerTotal, dealerTotal);
            _lastWin = false;
            _lastPlayerCards = playerTotal;
            _lastDealerCards = dealerTotal;
            _bjGameActive = false;
            _isPlaying = false;
            _gamesPlayed++;
            StateHasChanged();
            return;
        }

        await EndBlackjackGame(won, message);
    }

    private async Task EndBlackjackGame(bool won, string message)
    {
        _lastWin = won;
        _lastGameResult = message;
        _lastPlayerCards = GetPlayerTotal();
        _lastDealerCards = CalculateHandTotal(_bjDealerCards);
        _bjDealerCardHidden = false;
        _bjGameActive = false;
        _gamesPlayed++;

        if (won)
        {
            _wins++;
            var (paidBj, noteBj) = GameEngine.SettleGambling(Player!, _bjCurrentBet);
            _totalProfit += paidBj;
            if (noteBj != null) _lastGameResult += $" ({noteBj})";
        }
        else
        {
            GameEngine.SettleGambling(Player!, -_bjCurrentBet);
            _totalProfit -= _bjCurrentBet;
        }

        _isPlaying = false;
        StateHasChanged();
        await Task.Delay(100);
    }

