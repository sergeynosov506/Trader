    private void AcceptDeal()
    {
        if (Player == null || !_hasActiveDeal || _dealItem == null) return;

        var result = GameEngine.AcceptBarDeal(Player, _dealItem, _dealPrice ?? 0, _dealQuantity ?? 0);
        _message = result;
        _messageClass = result.Contains("Сделка") ? "alert-success" : "alert-danger";
