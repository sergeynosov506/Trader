            _message = "";
        }

        _pokerGameActive = false;
        _isPlaying = false;
        StateHasChanged();
    }

    private string EvaluatePokerHand(List<PokerCard> hand, out decimal multiplier)
    {
        multiplier = 0;
        if (hand == null || hand.Count != 5) return "Invalid Hand";

        var ranks = hand.Select(c => c.Value == 1 ? 14 : c.Value).OrderBy(r => r).ToList();
        var suits = hand.Select(c => c.Suit).ToList();

        bool isFlush = suits.Distinct().Count() == 1;

        bool isStraight = false;
        if (ranks.Distinct().Count() == 5 && (ranks[4] - ranks[0] == 4))
        {
            isStraight = true;
        }
        else if (ranks.SequenceEqual(new List<int> { 2, 3, 4, 5, 14 }))
        {
            isStraight = true;
        }

        var rankGroups = ranks.GroupBy(r => r)
                             .Select(g => new { Rank = g.Key, Count = g.Count() })
                             .OrderByDescending(g => g.Count)
                             .ToList();

        if (isFlush && isStraight && ranks.SequenceEqual(new List<int> { 10, 11, 12, 13, 14 }))
        {
            multiplier = 250m;
            return Loc["bar.payout_royal"];
        }

        if (isFlush && isStraight)
        {
            multiplier = 50m;
            return Loc["bar.payout_straight_flush"];
        }

        if (rankGroups[0].Count == 4)
        {
            multiplier = 25m;
            return Loc["bar.payout_four"];
        }

        if (rankGroups[0].Count == 3 && rankGroups[1].Count == 2)
        {
            multiplier = 9m;
            return Loc["bar.payout_full_house"];
        }

        if (isFlush)
        {
            multiplier = 6m;
            return Loc["bar.payout_flush"];
        }

        if (isStraight)
        {
            multiplier = 4m;
            return Loc["bar.payout_straight"];
        }

        if (rankGroups[0].Count == 3)
        {
            multiplier = 3m;
            return Loc["bar.payout_three"];
        }

        if (rankGroups[0].Count == 2 && rankGroups[1].Count == 2)
        {
            multiplier = 2m;
            return Loc["bar.payout_two_pair"];
        }

        if (rankGroups[0].Count == 2 && rankGroups[0].Rank >= 11)
        {
            multiplier = 1m;
            return Loc["bar.payout_jacks"];
        }

        return "No Combination";
    }

    private RenderFragment RenderPokerCard(PokerCard card, int index) => builder =>
    {
        var suit = card.Suit;
        var value = card.Value <= 13 && card.Value >= 1 ? CardValues[card.Value - 1] : "?";
        var isRed = suit == "♥" || suit == "♦";
        var isHeld = _pokerHeld[index];
        var cardClass = "playing-card" + (isHeld ? " poker-held-card" : "");
        
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "d-flex flex-column align-items-center");
        builder.AddAttribute(2, "style", "cursor: pointer; margin: 5px;");
        builder.AddAttribute(3, "onclick", EventCallback.Factory.Create(this, () => TogglePokerHold(index)));

        builder.OpenElement(4, "div");
        builder.AddAttribute(5, "class", cardClass);
        builder.AddAttribute(6, "style", $"width: 60px; height: 90px; background: white; border-radius: 5px; display: flex; flex-direction: column; align-items: center; justify-content: center; color: {(isRed ? "red" : "black")}; font-weight: bold; border: 1px solid #ccc; position: relative;");

        builder.OpenElement(7, "div");
        builder.AddAttribute(8, "style", "font-size: 1.4rem; line-height: 1.1;");
        builder.AddContent(9, value);
        builder.CloseElement();

        builder.OpenElement(10, "div");
        builder.AddAttribute(11, "style", "font-size: 1.2rem;");
        builder.AddContent(12, suit);
        builder.CloseElement();

        builder.CloseElement();

        if (isHeld)
        {
            builder.OpenElement(13, "span");
            builder.AddAttribute(14, "class", "poker-held-badge");
            builder.AddContent(15, Loc["bar.poker_hold"]);
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(16, "span");
            builder.AddAttribute(17, "style", "font-size: 0.7rem; visibility: hidden;");
            builder.AddContent(18, "HOLD");
            builder.CloseElement();
        }

        builder.CloseElement();
    };
}
