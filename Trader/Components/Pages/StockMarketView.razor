@using EconomicGame
@using EconomicGame.Configuration
@using EconomicGame.Models
@inject EconomicGame.Services.GameEngine GameEngine
@inject EconomicGame.Services.StockMarketService StockMarketService
@inject LocalizationService Loc
@implements IDisposable

<div class="stock-market">
    <h2>@Loc["stock.title"]</h2>

    @if (Player == null)
    {
        <p>@Loc["stock.create_character"]</p>
    }
    else if (Player.Vehicle == null)
    {
        <div class="alert alert-danger">
            <strong>@Loc["stock.no_access"]</strong> @Loc["stock.need_car"] <br/>
            @Loc["stock.buy_car_market"]
        </div>
    }
    else if (GameEngine.CurrentTime.Hour < GameConstants.StockMarketOpenHour || GameEngine.CurrentTime.Hour >= GameConstants.StockMarketCloseHour)
    {
        <div class="alert alert-warning">
            <strong>@Loc["stock.closed"]</strong> @string.Format(Loc["stock.hours"], GameConstants.StockMarketOpenHour, GameConstants.StockMarketCloseHour) <br/>
            @Loc["stock.current_time"]: @GameEngine.CurrentTime.ToShortTimeString()
        </div>
    }
    else
    {
        <!-- Portfolio Summary -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h6>@Loc["stock.balance"]</h6>
                        <h4 class="text-success">@Player.Money.ToString("C")</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h6>@Loc["stock.portfolio"]</h6>
                        <h4 class="text-primary">@StockMarketService.GetPortfolioValue(Player).ToString("C")</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        @{
                            var pnl = StockMarketService.GetUnrealizedPnL(Player);
                            var pnlColor = pnl >= 0 ? "text-success" : "text-danger";
                            var pnlIcon = pnl >= 0 ? "📈" : "📉";
                        }
                        <h6>@pnlIcon P&L</h6>
                        <h4 class="@pnlColor">@pnl.ToString("+#,##0.00;-#,##0.00")</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h6>@Loc["stock.dividends"]</h6>
                        <h4 class="text-info">@Player.DividendIncome.ToString("C")</h4>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @_messageClass alert-dismissible fade show">
                @_message
                <button type="button" class="btn-close" @onclick="() => _message = string.Empty"></button>
            </div>
        }

        <!-- Stocks Table -->
        <div class="card mb-3">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@Loc["stock.stocks"]</h5>
                <small>@Loc["stock.fee"]: @((GameConstants.StockBrokerFee * 100).ToString("F0"))%</small>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th></th>
                            <th>@Loc["stock.ticker"]</th>
                            <th>@Loc["stock.company"]</th>
                            <th>@Loc["stock.price"]</th>
                            <th>@Loc["stock.change"]</th>
                            <th>@Loc["stock.yield"]</th>
                            <th>@Loc["stock.available"]</th>
                            <th>@Loc["stock.held"]</th>
                            <th>@Loc["stock.actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stock in StockMarketService.Stocks)
                        {
                            var change = stock.PriceHistory.Count >= 2
                                ? stock.SharePrice - stock.PriceHistory[stock.PriceHistory.Count - 2]
                                : 0;
                            var changePercent = stock.PriceHistory.Count >= 2 && stock.PriceHistory[stock.PriceHistory.Count - 2] > 0
                                ? (change / stock.PriceHistory[stock.PriceHistory.Count - 2]) * 100
                                : 0;
                            var changeColor = change >= 0 ? "text-success" : "text-danger";
                            var changeIcon = change > 0 ? "▲" : (change < 0 ? "▼" : "—");
                            var playerShares = Player.Portfolio.Holdings.GetValueOrDefault(stock.Ticker, 0);

                            <tr>
                                <td style="font-size: 1.5rem;">@stock.Emoji</td>
                                <td><strong>@stock.Ticker</strong></td>
                                <td>@stock.CompanyName</td>
                                <td><strong>@stock.SharePrice.ToString("C")</strong></td>
                                <td class="@changeColor">
                                    @changeIcon @changePercent.ToString("F2")%
                                </td>
                                <td>
                                    <span class="badge bg-info">@((stock.DividendYield * 100).ToString("F1"))%</span>
                                </td>
                                <td>@stock.AvailableShares</td>
                                <td>
                                    @if (playerShares > 0)
                                    {
                                        var avgBuy = Player.Portfolio.AvgBuyPrice.GetValueOrDefault(stock.Ticker, stock.SharePrice);
                                        var holdingPnl = (stock.SharePrice - avgBuy) * playerShares;
                                        var holdPnlColor = holdingPnl >= 0 ? "text-success" : "text-danger";
                                        <span>@playerShares @Loc["stock.shares_short"]</span>
                                        <br/>
                                        <small class="@holdPnlColor">@holdingPnl.ToString("+#,##0.00;-#,##0.00")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <div class="d-flex align-items-center gap-1">
                                            <input type="number" @bind="_stockQuantities[stock.Ticker]" min="1" max="@stock.AvailableShares"
                                                   class="form-control form-control-sm" style="width: 60px;" />
                                            <button class="btn btn-sm btn-success" @onclick="() => BuyStock(stock.Ticker)">@Loc["stock.buy"]</button>
                                            @if (playerShares > 0)
                                            {
                                                <button class="btn btn-sm btn-warning" @onclick="() => SellStock(stock.Ticker)">@Loc["stock.sell"]</button>
                                                <button class="btn btn-sm btn-danger" @onclick="() => SellAllStock(stock.Ticker)" title="@Loc["stock.sell_all"]">📤</button>
                                            }
                                        </div>
                                        <button class="btn btn-sm btn-outline-info" @onclick="() => ShowChart(stock)">@Loc["stock.chart"]</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Price Chart Modal -->
        @if (_selectedStock != null && _selectedStock.PriceHistory.Any())
        {
            <div class="modal fade show" style="display: block; background-color: rgba(0, 0, 0, 0.65); backdrop-filter: blur(4px); z-index: 1050;" tabindex="-1" role="dialog">
                <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                    <div class="modal-content" style="background-color: #16213e; border: 1px solid rgba(255, 255, 255, 0.15); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5); border-radius: 12px; overflow: hidden;">
                        <div class="modal-header text-white" style="border-bottom: 1px solid rgba(255, 255, 255, 0.1); background-color: #1a1a2e; padding: 1rem 1.5rem;">
                            <h5 class="modal-title d-flex align-items-center">
                                <span class="me-2">@_selectedStock.Emoji</span> @_selectedStock.CompanyName (@_selectedStock.Ticker) - @Loc["stock.chart"]
                            </h5>
                            <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="() => _selectedStock = null"></button>
                        </div>
                        <div class="modal-body" style="padding: 1.5rem;">
                            @{
                                var prices = _selectedStock.PriceHistory.ToList();
                                var minPrice = prices.Min();
                                var maxPrice = prices.Max();
                                var priceRange = maxPrice - minPrice;
                                if (priceRange == 0) priceRange = 1;

                                var chartWidth = 600;
                                var chartHeight = 200;
                                var padding = 50;
                                var graphWidth = chartWidth - padding * 2;
                                var graphHeight = chartHeight - padding;

                                var points = new List<string>();
                                var areaPoints = new List<string>();
                                areaPoints.Add($"{padding},{chartHeight - padding}");

                                for (int i = 0; i < prices.Count; i++)
                                {
                                    var x = padding + (i * graphWidth / Math.Max(1, prices.Count - 1));
                                    var y = chartHeight - padding - (int)(((double)(prices[i] - minPrice) / (double)priceRange) * graphHeight);
                                    points.Add($"{x},{y}");
                                    areaPoints.Add($"{x},{y}");
                                }
                                areaPoints.Add($"{padding + graphWidth},{chartHeight - padding}");

                                var currentPrice = prices.LastOrDefault();
                                var previousPrice = prices.Count > 1 ? prices[prices.Count - 2] : currentPrice;
                                var trendColor = currentPrice > previousPrice ? "#28a745" : (currentPrice < previousPrice ? "#dc3545" : "#6c757d");
                            }

                            <div class="card" style="border: none; background: transparent;">
                                <div class="card-body p-0">
                                    <div class="d-flex justify-content-between text-white mb-3 px-2">
                                        <span>@Loc["stock.chart_min"]: <strong class="text-danger">@minPrice.ToString("C")</strong></span>
                                        <span>@Loc["stock.chart_current"]: <strong style="color: @trendColor">@currentPrice.ToString("C")</strong></span>
                                        <span>@Loc["stock.chart_max"]: <strong class="text-success">@maxPrice.ToString("C")</strong></span>
                                    </div>

                                    <svg width="100%" viewBox="0 0 @chartWidth @chartHeight" style="max-width: 100%; height: auto; display: block;">
                                        @for (int i = 0; i <= 4; i++)
                                        {
                                            var y = padding + (i * graphHeight / 4);
                                            <line x1="@padding" y1="@y" x2="@(chartWidth - padding)" y2="@y"
                                                  stroke="rgba(255,255,255,0.1)" stroke-dasharray="5,5" />
                                        }

                                        <polygon points="@string.Join(" ", areaPoints)"
                                                 fill="url(#stock-gradient-@_selectedStock.Ticker)" opacity="0.25" />

                                        <defs>
                                            <linearGradient id="stock-gradient-@_selectedStock.Ticker" x1="0%" y1="0%" x2="0%" y2="100%">
                                                <stop offset="0%" style="stop-color: @trendColor; stop-opacity: 0.8" />
                                                <stop offset="100%" style="stop-color: @trendColor; stop-opacity: 0.05" />
                                            </linearGradient>
                                        </defs>

                                        <polyline points="@string.Join(" ", points)"
                                                  fill="none" stroke="@trendColor" stroke-width="3"
                                                  stroke-linecap="round" stroke-linejoin="round" />

                                        @for (int i = 0; i < prices.Count; i++)
                                        {
                                            var x = padding + (i * graphWidth / Math.Max(1, prices.Count - 1));
                                            var y = chartHeight - padding - (int)(((double)(prices[i] - minPrice) / (double)priceRange) * graphHeight);

                                            <circle cx="@x" cy="@y" r="3" fill="@trendColor" stroke="white" stroke-width="1" />

                                            @if (i == prices.Count - 1)
                                            {
                                                <circle cx="@x" cy="@y" r="6" fill="@trendColor" opacity="0.3">
                                                    <animate attributeName="r" values="6;10;6" dur="1.5s" repeatCount="indefinite" />
                                                </circle>
                                            }
                                        }
                                    </svg>

                                    <div class="d-flex justify-content-between px-4 text-muted small mt-2">
                                        <span>@Loc["stock.oldest"]</span>
                                        <span>@Loc["stock.latest"]</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer" style="border-top: 1px solid rgba(255, 255, 255, 0.1); background-color: #1a1a2e; padding: 0.75rem 1.5rem;">
                            <button type="button" class="btn btn-outline-light btn-sm" @onclick="() => _selectedStock = null">@Loc["common.close"]</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Holdings Portfolio -->
        @if (Player.Portfolio.Holdings.Any())
        {
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">@Loc["stock.my_portfolio"]</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>@Loc["stock.ticker"]</th>
                                <th>@Loc["stock.shares"]</th>
                                <th>@Loc["stock.avg_buy"]</th>
                                <th>@Loc["stock.current_price"]</th>
                                <th>@Loc["stock.value"]</th>
                                <th>P&L</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var holding in Player.Portfolio.Holdings)
                            {
                                var stock = StockMarketService.Stocks.FirstOrDefault(s => s.Ticker == holding.Key);
                                if (stock == null) continue;
                                var avgBuy = Player.Portfolio.AvgBuyPrice.GetValueOrDefault(holding.Key, stock.SharePrice);
                                var value = stock.SharePrice * holding.Value;
                                var holdPnl = (stock.SharePrice - avgBuy) * holding.Value;
                                var holdPnlColor = holdPnl >= 0 ? "text-success" : "text-danger";

                                <tr>
                                    <td><strong>@stock.Emoji @holding.Key</strong></td>
                                    <td>@holding.Value</td>
                                    <td>@avgBuy.ToString("C")</td>
                                    <td>@stock.SharePrice.ToString("C")</td>
                                    <td><strong>@value.ToString("C")</strong></td>
                                    <td class="@holdPnlColor"><strong>@holdPnl.ToString("+#,##0.00;-#,##0.00")</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- Pending Orders -->
        @if (Player.Portfolio.PendingOrders.Any())
        {
            <div class="card mb-3">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">@Loc["stock.pending_orders"]</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped mb-0">
                        <thead>
                            <tr>
                                <th>@Loc["stock.ticker"]</th>
                                <th>@Loc["stock.type"]</th>
                                <th>@Loc["stock.action"]</th>
                                <th>@Loc["stock.price"]</th>
                                <th>@Loc["stock.qty_short"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Player.Portfolio.PendingOrders)
                            {
                                <tr>
                                    <td><strong>@order.Ticker</strong></td>
                                    <td>
                                        @(order.Type switch
                                        {
                                            OrderType.Limit => Loc["stock.order_limit"],
                                            OrderType.StopLoss => Loc["stock.order_stoploss"],
                                            _ => Loc["stock.order_market"]
                                        })
                                    </td>
                                    <td>@(order.IsBuy ? Loc["stock.buy_green"] : Loc["stock.sell_red"])</td>
                                    <td>@order.TargetPrice.ToString("C")</td>
                                    <td>@order.Quantity</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelOrder(order.OrderId)">@Loc["stock.cancel"]</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- Limit Order Form -->
        <div class="card">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">@Loc["stock.create_order"]</h5>
            </div>
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small">@Loc["stock.ticker"]</label>
                        <select @bind="_orderTicker" class="form-select form-select-sm">
                            @foreach (var stock in StockMarketService.Stocks)
                            {
                                <option value="@stock.Ticker">@stock.Emoji @stock.Ticker</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">@Loc["stock.type"]</label>
                        <select @bind="_orderType" class="form-select form-select-sm">
                            <option value="Limit">@Loc["stock.order_limit_opt"]</option>
                            <option value="StopLoss">@Loc["stock.order_stoploss"]</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">@Loc["stock.action"]</label>
                        <select @bind="_orderIsBuy" class="form-select form-select-sm">
                            <option value="true">@Loc["stock.buy"]</option>
                            <option value="false">@Loc["stock.sell"]</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">@Loc["stock.price"]</label>
                        <input type="number" @bind="_orderPrice" step="0.01" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">@Loc["stock.qty_short"]</label>
                        <input type="number" @bind="_orderQuantity" min="1" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary btn-sm w-100" @onclick="PlaceOrder">@Loc["stock.place"]</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public EconomicGame.Player? Player { get; set; }

    private string _message = "";
    private string _messageClass = "alert-info";
    private Stock? _selectedStock;
    private Dictionary<string, int> _stockQuantities = new();

    // Order form
    private string _orderTicker = "";
    private string _orderType = "Limit";
    private string _orderIsBuy = "true";
    private decimal _orderPrice = 0;
    private int _orderQuantity = 10;

    protected override void OnInitialized()
    {
        Loc.OnLanguageChanged += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Loc.OnLanguageChanged -= Refresh;
    }

    protected override void OnParametersSet()
    {
        foreach (var stock in StockMarketService.Stocks)
        {
            if (!_stockQuantities.ContainsKey(stock.Ticker))
                _stockQuantities[stock.Ticker] = 10;
        }
        if (string.IsNullOrEmpty(_orderTicker) && StockMarketService.Stocks.Any())
            _orderTicker = StockMarketService.Stocks.First().Ticker;
    }

    private void BuyStock(string ticker)
    {
        if (Player == null) return;
        var quantity = _stockQuantities.GetValueOrDefault(ticker, 10);
        _message = StockMarketService.BuyStock(Player, ticker, quantity);
        // Service messages are still in Russian; detect success by Russian stems
        _messageClass = _message.StartsWith("Куплено") || _message.StartsWith("Bought") ? "alert-success" : "alert-danger";
        StateHasChanged();
    }

    private void SellStock(string ticker)
    {
        if (Player == null) return;
        var quantity = _stockQuantities.GetValueOrDefault(ticker, 10);
        _message = StockMarketService.SellStock(Player, ticker, quantity);
        _messageClass = _message.StartsWith("Продано") || _message.StartsWith("Sold") ? "alert-success" : "alert-danger";
        StateHasChanged();
    }

    private void SellAllStock(string ticker)
    {
        if (Player == null) return;
        var shares = Player.Portfolio.Holdings.GetValueOrDefault(ticker, 0);
        if (shares <= 0)
        {
            _message = Loc["stock.no_shares_to_sell"];
            _messageClass = "alert-danger";
            StateHasChanged();
            return;
        }
        _message = StockMarketService.SellStock(Player, ticker, shares);
        _messageClass = _message.StartsWith("Продано") || _message.StartsWith("Sold") ? "alert-success" : "alert-danger";
        StateHasChanged();
    }

    private void ShowChart(Stock stock)
    {
        _selectedStock = stock;
        StateHasChanged();
    }

    private void PlaceOrder()
    {
        if (Player == null) return;
        var orderType = _orderType == "Limit" ? OrderType.Limit : OrderType.StopLoss;
        var isBuy = _orderIsBuy == "true";
        _message = StockMarketService.PlaceOrder(Player, _orderTicker, orderType, _orderPrice, _orderQuantity, isBuy);
        _messageClass = _message.Contains("создан") || _message.Contains("placed") ? "alert-success" : "alert-danger";
        StateHasChanged();
    }

    private void CancelOrder(Guid orderId)
    {
        if (Player == null) return;
        _message = StockMarketService.CancelOrder(Player, orderId);
        _messageClass = "alert-info";
        StateHasChanged();
    }
}
